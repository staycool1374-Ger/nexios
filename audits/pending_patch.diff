-+    JARVIS_ASSERT_EQ(0x10000000ULL, msg.fault_va);
-+    JARVIS_ASSERT_EQ(t->id, msg.client_id);
-+    // The record is STILL pending after RECV (two-phase protocol).
-+    JARVIS_ASSERT(ipc::PagerRegistry::pending_fault(*cur));
