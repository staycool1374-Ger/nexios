+/// @file mem_handover_errors.hpp
+/// @brief Mem-mgr handover error codes (M4, #563; X-macro table).
+#pragma once
+
+#include <types.hpp>
+#include <assert.hpp>
+
+namespace kernel::errors {
+
+#define MEMHANDOVER_ERROR_CODES                                                \
+    X(OK, 0, "OK")                                                             \
+    X(ALREADY_FROZEN, 1, "Handover already completed")                         \
+    X(NO_ROOT, 2, "Root task has no CSpace")                                   \
+    X(CSPACE_FULL, 3, "No free CNode slot for handover")                    \
+    X(UNTYPED_CAP_FULL, 4, "Untyped live bound reached")                       \
+    X(NO_FREE_RUNS, 5, "No free runs to hand over")                            \
+    X(REGISTRY_FULL, 6, "Handover registry full")                              \
+    X(BAD_TARGET, 7, "Bad handover target")                                    \
+    X(ALREADY_TRANSFERRED, 8, "Handover already moved")                    \
+    X(STALE_SLOT, 9, "Handover slot no longer names its cap")
+
+/// @brief Mem-mgr handover errors.
+// NOLINTNEXTLINE(performance-enum-size)
+enum MemHandoverError : uint64_t {
+#define X(name, num, msg) MEM_HANDOVER_ERR_##name = (num),
+    MEMHANDOVER_ERROR_CODES
+#undef X
+};
+
+/// @brief OK anchor: success is zero by convention.
+static_assert(MEM_HANDOVER_ERR_OK == 0, "error OK must be 0");
+
+/// @brief Return a human-readable string for a handover error code.
+template <> inline const char *error_string(MemHandoverError e) {
+    switch (e) {
+#define X(name, num, msg)                                                      \
+    case MEM_HANDOVER_ERR_##name:                                              \
+        return msg;
+        MEMHANDOVER_ERROR_CODES
+#undef X
+    }
+    return "Unknown mem-handover error";
+}
+
+} // namespace kernel::errors
diff --git a/src/kernel/memory/mem_pressure.cpp b/src/kernel/memory/mem_pressure.cpp
new file mode 100644
index 000000000..922a12197
--- /dev/null
+++ b/src/kernel/memory/mem_pressure.cpp
@@ -0,0 +1,73 @@
+/// @file kernel/memory/mem_pressure.cpp
+/// @brief R-MEM unstable-state warning latch (M4, #575 kernel half).
+#include <kernel/memory/mem_pressure.hpp>
+#include <kernel/log/dmesg.hpp>
+#include <kernel/nexios_config.h>
+
+namespace kernel {
+namespace mem_pressure {
+
+namespace {
+/// Single-word latch state: 0 = clear, 1 = latched. Plain atomics —
+/// no lock, no allocation, callable from any lock context.
+uint8_t g_latched = 0;
+MemPressureReason g_reason = MemPressureReason::NONE;
+uint64_t g_count = 0;
+bool g_pending = false;
+} // namespace
+
+void latch(MemPressureReason reason) noexcept {
+    __atomic_fetch_add(&g_count, 1, __ATOMIC_RELAXED);
+    uint8_t expected = 0;
+    // First caller wins the row; everyone counts (sustained-pressure
+    // telemetry without serial spam).
+    if (!__atomic_compare_exchange_n(&g_latched, &expected, 1, false,
+                                     __ATOMIC_RELAXED, __ATOMIC_RELAXED)) {
+        return;
+    }
+    // Winner-only stores (§11.6 all-or-nothing: every shared index is
+    // atomic from every context — the losers never touch these).
+    __atomic_store_n(&g_reason, reason, __ATOMIC_RELAXED);
+    __atomic_store_n(&g_pending, true, __ATOMIC_RELAXED);
+    // Lock-free emit path only (dmesg_push_sev never takes a lock — same
+    // contract the panic path relies on).
+    log::dmesg_push_sev(log::ErrorSubsystem::PMM,
+                        log::kDmesgBase_PMM + 4, log::LogSeverity::ERROR,
+                        "mem: unstable-state warning (exhaustion/pressure)",
+                        static_cast<uintptr_t>(reason));
+}
+
+void clear() noexcept {
+    __atomic_store_n(&g_reason, MemPressureReason::NONE, __ATOMIC_RELAXED);
+    __atomic_store_n(&g_pending, false, __ATOMIC_RELAXED);
+    __atomic_store_n(&g_latched, 0, __ATOMIC_RELAXED);
+}
+
+bool latched() noexcept {
+    return __atomic_load_n(&g_latched, __ATOMIC_RELAXED) != 0;
+}
+
+MemPressureReason reason() noexcept {
+    return __atomic_load_n(&g_reason, __ATOMIC_RELAXED);
+}
+
+uint64_t count() noexcept {
+    return __atomic_load_n(&g_count, __ATOMIC_RELAXED);
+}
+
+bool pending_notify() noexcept {
+    return __atomic_load_n(&g_pending, __ATOMIC_RELAXED);
+}
+
+void drain_pending() noexcept {
+    // M5 installs the supervisor Notify sink here. Until then, clearing
+    // unconditionally keeps the latch from wedging on an absent consumer.
+    __atomic_store_n(&g_pending, false, __ATOMIC_RELAXED);
+}
+
+uint8_t threshold_pct() noexcept {
+    return CONFIG_MEM_PRESSURE_THRESHOLD_PCT;
+}
+
+} // namespace mem_pressure
+} // namespace kernel
diff --git a/src/kernel/memory/mem_pressure.hpp b/src/kernel/memory/mem_pressure.hpp
new file mode 100644
index 000000000..69bdf1999
--- /dev/null
+++ b/src/kernel/memory/mem_pressure.hpp
@@ -0,0 +1,54 @@
+/// @file kernel/memory/mem_pressure.hpp
+/// @brief R-MEM unstable-state warning latch (M4, #575 kernel half).
+///
+/// Memory exhaustion is unrecoverable: the manager MUST emit an explicit
+/// unstable-state warning (diagnostic + supervisor notify) instead of
+/// failing silently. This TU is the emit half: a zero-alloc, lock-free,
+/// one-shot latch callable from inside pmm_lock_/pool_lock_/OOM-handler
+/// windows. The supervisor Notify sink is wired at M5
+/// (drain_pending() is a no-op until then).
+#pragma once
+
+#include <types.hpp>
+
+namespace kernel {
+namespace mem_pressure {
+
+/// @brief Why the pressure latch fired. NONE = never latched.
+enum class MemPressureReason : uint8_t {
+    NONE = 0,
+    PMM_FROZEN_DENY = 1, ///< post-freeze allocation denied (STATIC_POOLS_ONLY)
+    PMM_OOM = 2,         ///< OOM-handler retry exhausted
+    BUDGET_DENY = 3,     ///< per-task budget exceeded
+    BUFPOOL_EMPTY = 4,    ///< BufferPool cache exhausted, no PMM fallback
+    HANDOVER_CAPPED = 5, ///< handover run table full, surplus retained
+};
+
+/// @brief Latch the unstable-state warning. First caller wins and emits
+///        exactly one dmesg row (kDmesgBase_PMM + pressure code);
+///        latecomers only bump count(). No locks, no allocation, no
+///        Logger — safe from any lock context. Never panics.
+void latch(MemPressureReason reason) noexcept;
+/// @brief Re-arm after supervisor ack (test hook uses the same path).
+void clear() noexcept;
+/// @brief True once latched (until clear()).
+bool latched() noexcept;
+/// @brief Latching reason (NONE when clear).
+MemPressureReason reason() noexcept;
+/// @brief Total latch calls since the last clear (diagnostic: sustained
+///        pressure reads > 1 while exactly one row is emitted).
+uint64_t count() noexcept;
+/// @brief True when a supervisor Notify is owed (set by latch, cleared
+///        by drain_pending()).
+bool pending_notify() noexcept;
+/// @brief M5 sink: hand the pending notify to the supervisor. No-op
+///        while no sink is installed (clears the flag regardless so the
+///        latch never wedges on an absent consumer).
+void drain_pending() noexcept;
+/// @brief Configured pressure threshold percent (policy input for the
+///        M5 supervisor reaction; the latch itself fires on exhaustion
+///        events, which are definitionally past-threshold).
+uint8_t threshold_pct() noexcept;
+
+} // namespace mem_pressure
+} // namespace kernel
