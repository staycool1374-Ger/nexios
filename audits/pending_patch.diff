--- a/src/kernel/test/test_init.cpp
+++ b/src/kernel/test/test_init.cpp
@@ -23,6 +23,8 @@
 #include <logger.hpp>
 #include <kernel/task/scheduler.hpp>
 #include <kernel/task/task.hpp>
+#include <kernel/ipc/ipc.hpp>
