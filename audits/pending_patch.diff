+            break;
+        case TestTouchWarn::kUnmapPml4:
+            Logger::warn("unmap_page: test unmapping kernel-space VA 0x%lx "
+                         "(pml4_idx=%zu)",
+                         va, idx);
+            break;
+        case TestTouchWarn::kAccessPml4:
+            Logger::warn("virt_to_phys: test accessing kernel-space VA 0x%lx "
+                         "(pml4_idx=%zu)",
