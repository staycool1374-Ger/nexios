diff --git a/docs/specs/term-srv.md b/docs/specs/term-srv.md
new file mode 100644
index 000000000..b1d8ed3b0
--- /dev/null
+++ b/docs/specs/term-srv.md
@@ -0,0 +1,47 @@
+# term-srv + log-srv — Policy PD Contracts (issue #51, strangler step a)
+
+Userspace terminal-emulation and log-sink PDs behind `CONFIG_TERM_SRV` /
+`CONFIG_LOG_SRV` (default 0). Step-a delivers PD skeletons + SDF rows +
+Kconfig OFF shim + loopback/parity + fault demo. No flip: emulation
+policy and log sinking stay in-kernel.
+
+## Wire
+
+48 B `TermRpc` / `LogRpc` (mirrors `TimerRpc`; fits
+`CONFIG_IPC_FAST_PAYLOAD_BYTES`). Ops: BIND (+ policy ops unimplemented
+pre-flip), INJECT_POISON / INJECT_DROP (one-shot fault drills).
+Control via `send_sync` (+FAST ≤48B). Bounded wait
+(`send_sync_bounded`, `kRpcGuardTicks`); epoch + owner id/gen +
+op-echo validated replies; tombstone drain for dead owners.
+
+## SDF rows (empty by structural rule)
+
+TERM_SRV and LOG_SRV rows carry zero caps (`sdf_policy_only` enforces
+emptiness; `sdf_compose` rejects any non-empty policy row). Borrowed
+mechanics only: serial TX/RX + framebuffer present for term-srv, Klog/
+Dmesg *read* for log-srv probes. No MMIO, no IRQ, no DMA, no frames —
+device ownership stays with #48 (fb) and the kernel (serial/console).
+`sdf_rebind` re-derives nothing (empty row) but bumps the epoch so a
+restarted PD can never consume pre-restart replies.
+
+## Bounded ops
+
+Scroll/clear/redraw/status-bar ops carry row budgets; UC MMIO writes
+stay out of the PD (no device access at all). Drain paths are bounded
+(16-entry tombstone ring, drop-oldest with counter). No spinlock across
+`reschedule`; no allocation on any path; OOM-as-error everywhere.
+
+## Pre-flip status
+
+Emulation (Terminal/draw/scroll/prompt) and log sinking stay in-kernel.
+The PDs answer BIND and typed `-ENOSYS` for everything else (verified
+byte-identical OFF vs ON: the kernel never calls them). The flip
+(policy migration, Klog/Dmesg consumer handoff) is a later step with
+the §7 gate (audit + test-full debug AND release + delta-0).
+
+## Gates
+
+ON build boots both PDs (daemon PIDs live); parity
+`tools/term-srv-parity.sh` OFF == ON S TM sets; fault demo
+`tools/term-srv-fault-mon.sh` kill → restart → rebind → re-run with
+no admission wedge (serial artifacts under the tool's outdir).
diff --git a/src/kernel/log/log_srv.cpp b/src/kernel/log/log_srv.cpp
new file mode 100644
index 000000000..4643a4339
--- /dev/null
+++ b/src/kernel/log/log_srv.cpp
@@ -0,0 +1,160 @@
+#include <kernel/log/log_srv.hpp>
+
+#if CONFIG_LOG_SRV
+
+/*
+ * NexIOS RTOS — Log-sink PD proxy (issue #51).
+ * Whole TU is `#if CONFIG_LOG_SRV`-guarded: the OFF build (`0`,
+ * shipped default) yields an empty TU (no symbols), so the link is
+ * byte-identical to the pre-#51 tree. The sink path never touches
+ * Dmesg/Klog — step-a proxy only, no log-source changes.
+ */
+
+#include <kernel/ipc/ipc.hpp>
+#include <kernel/task/scheduler.hpp>
+#include <kernel/task/task.hpp>
+
+namespace kernel {
+namespace log_srv {
+namespace {
+
+uint64_t g_log_srv_pid = 0;
+uint32_t g_log_srv_epoch = 1;
+
+struct Tombstone {
+    uint32_t owner_id;
+    uint32_t owner_gen;
+};
+
+Tombstone g_tombstones[16] = {};
+uint64_t g_tombstone_count = 0;
+
+/// @brief Bounded wait for one server RPC (coarse ticks).
+/// Fail-closed `-EAGAIN` past this; never parks a kernel task forever.
+constexpr uint64_t kRpcGuardTicks = 5000;
+
+} // namespace
+
+void set_log_srv_pid(uint64_t pid) {
+    g_log_srv_pid = pid;
+}
+
+uint64_t get_log_srv_pid() {
+    return __atomic_load_n(&g_log_srv_pid, __ATOMIC_RELAXED);
+}
+
+bool log_srv_alive() {
+    const uint64_t pid = get_log_srv_pid();
+    if (pid == 0) {
+        return false;
+    }
+    auto *srv = Scheduler::find_task(pid);
+    if (srv == nullptr) {
+        return false;
+    }
+    return srv->state != TaskState::TERMINATED &&
+           srv->state != TaskState::REAPED;
+}
+
+uint32_t log_srv_epoch() {
+    return __atomic_load_n(&g_log_srv_epoch, __ATOMIC_RELAXED);
+}
+
+void log_srv_bump_epoch() {
+    __atomic_fetch_add(&g_log_srv_epoch, 1U, __ATOMIC_RELAXED);
+    __atomic_store_n(&g_tombstone_count, 0, __ATOMIC_RELAXED);
+}
+
+void log_srv_on_restart(uint64_t pid) {
+    set_log_srv_pid(pid);
+    log_srv_bump_epoch();
+}
+
+void log_srv_note_dead_owner(uint32_t owner_id, uint32_t owner_gen) {
+    // Lock-free ring write (teardown context: no locks, no IPC).
+    uint64_t count =
+        __atomic_load_n(&g_tombstone_count, __ATOMIC_RELAXED);
+    if (count >= 16) {
+        return; // bounded residual drop (documented, ≤ table size)
+    }
+    g_tombstones[count].owner_id = owner_id;
+    g_tombstones[count].owner_gen = owner_gen;
+    __atomic_store_n(&g_tombstone_count, count + 1, __ATOMIC_RELAXED);
+}
+
+bool log_srv_rpc(const LogRpc &req, LogRpc &reply) {
+    const uint64_t pid = get_log_srv_pid();
+    if (pid == 0 || !log_srv_alive()) {
+        return false;
+    }
+    auto *cur = Scheduler::current_task();
+    if (cur == nullptr) {
+        return false;
+    }
+    Message msg{};
+    msg.type = static_cast<uint64_t>(req.op);
+    msg.priority = cur->priority;
+    __builtin_memcpy(msg.data, &req, sizeof(req));
+    msg.data_size = sizeof(req);
+    Message raw{};
+    if (!IPC::send_sync_bounded(pid, msg, raw, kRpcGuardTicks)) {
+        return false;
+    }
+    if (raw.data_size != sizeof(reply)) {
+        return false;
+    }
+    __builtin_memcpy(&reply, raw.data, sizeof(reply));
+    // Reply identity: server, epoch, owner (id+gen). A mismatch is
+    // dropped by the caller (bounded re-wait), never consumed.
+    if (raw.sender_id != pid || reply.epoch != log_srv_epoch() ||
+        reply.owner_id != req.owner_id ||
+        reply.owner_gen != req.owner_gen) {
+        return false;
+    }
+    return true;
+}
+
+namespace {
+
+bool log_srv_bind_op(LogSrvOp op, int64_t *out_status) {
+    LogRpc req{};
+    req.op = static_cast<uint8_t>(op);
+    auto *cur = Scheduler::current_task();
+    if (cur == nullptr) {
+        return false;
+    }
+    req.owner_id = static_cast<uint32_t>(cur->id);
+    req.owner_gen = cur->generation;
+    req.epoch = log_srv_epoch();
+    LogRpc reply{};
+    if (!log_srv_rpc(req, reply)) {
+        return false;
+    }
+    if (out_status != nullptr) {
+        *out_status = reply.status;
+    }
+    return true;
+}
+
+} // namespace
+
+int64_t log_srv_probe_bind() {
+    int64_t status = -38;
+    if (!log_srv_bind_op(LogSrvOp::BIND, &status)) {
+        return -38; // -ENOSYS: server unavailable pre-flip
+    }
+    return status;
+}
+
+int64_t log_srv_fault_drop() {
+    int64_t status = -38;
+    if (!log_srv_bind_op(LogSrvOp::INJECT_DROP, &status)) {
+        return -38; // -ENOSYS: server unavailable pre-flip
+    }
+    return status;
+}
+
+} // namespace log_srv
+} // namespace kernel
+
+#endif // CONFIG_LOG_SRV
