+///        Local CPU only; cross-CPU invalidation is out of scope.
+/// @param pcid Owning context id, ignored (0 = untagged/kernel).
+inline void tlb_purge_context([[maybe_unused]] uint16_t pcid) {
+    arch_page_table_tlb_flush_all();
