+#!/usr/bin/env python3
+"""Link-stage artifact contract check (issue #170).
+
+Usage:
+    python3 tools/meson/tests/test_stage_paths.py <builddir> <arch>
+
+Asserts every path the link+package stages promise exists and is
+non-trivial: patched ELF, .lto-mode marker, baked test-config,
+kernel.map, ISO (x86_64), and the legacy staging copies.
+"""
+
+import sys
+from pathlib import Path
+
+
+def main():
+    """Check link-stage artifacts for one arch builddir."""
+    if len(sys.argv) != 3:
+        print("usage: test_stage_paths.py <builddir> <arch>")
+        return 2
+    builddir = Path(sys.argv[1])
+    arch = sys.argv[2]
+    repo = Path(__file__).resolve().parent.parent.parent.parent
+    problems = []
+
+    def need(path, min_size=1024, label=None):
+        """Require a non-trivial file, recording problems."""
+        name = label or str(path)
+        if not path.exists():
+            problems.append("missing: %s" % name)
+        elif path.stat().st_size < min_size:
+            problems.append("too small (%d): %s" % (path.stat().st_size, name))
+
+    need(builddir / "src" / "kernel-debug.elf", label="builddir kernel ELF")
+    need(builddir / "kernel.map", label="builddir kernel.map")
+    if arch == "x86_64":
+        need(builddir / "src" / "nexios-rtos.iso", label="builddir boot ISO")
+        iso = builddir / "src" / "nexios-rtos.iso"
+        legacy_ok = False
+        for name in ("debug", "release"):
+            legacy_iso = repo / name / "nexios-rtos.iso"
+            if legacy_iso.exists() and iso.exists():
+                if legacy_iso.read_bytes() == iso.read_bytes():
+                    legacy_ok = True
+        if not legacy_ok:
+            problems.append("missing or stale: legacy boot ISO "
+                            "(debug/ or release/ must byte-match builddir)")
+    marker = builddir / (".lto-mode-" + arch)
+    if not marker.exists():
+        problems.append("missing: .lto-mode marker")
+    baked = builddir / (".baked-test-config-" + arch)
+    if not baked.exists():
+        problems.append("missing: builddir baked test-config")
+    need(repo / "build" / "kernel-debug.elf", label="legacy kernel-debug.elf")
+    need(repo / "build" / "kernel.elf", label="legacy kernel.elf")
+    need(repo / "build" / "kernel.map", label="legacy kernel.map")
+    if arch == "riscv64":
+        need(builddir / "src" / "kernel-riscv64.bin",
+             label="builddir riscv BIN")
+        need(repo / "build" / "kernel-riscv64.bin",
+             label="legacy riscv BIN")
+    if problems:
+        print("stage-path FAILED (%s):" % arch)
+        for problem in problems:
+            print("  - %s" % problem)
+        return 1
+    print("stage-path PASSED (%s)" % arch)
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/tools/meson/tests/test_verdict_parser.py b/tools/meson/tests/test_verdict_parser.py
new file mode 100644
index 000000000..37d592a57
--- /dev/null
+++ b/tools/meson/tests/test_verdict_parser.py
@@ -0,0 +1,84 @@
+#!/usr/bin/env python3
+"""Verdict-contract tests for the Meson harness (issue #170, A1).
+
+Usage:
+    python3 tools/meson/tests/test_verdict_parser.py <builddir> <arch>
+
+Exercises qemu_test.classify_verdict (the single source of truth — no
+duplicated logic) over synthetic transcripts:
+- a TEST SUMMARY with failures stays FAIL (never retried, never PASS)
+- missing SUMMARY / zero S-lines / 0-0 counts are FAIL
+  (TIMEOUT/QEMU_EXIT), never PASS
+- an expected-panic marker plus its log line is PASS
+- STALL-RECOVERED attaches only to a final PASS
+"""
+
+import sys
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
+from qemu_test import classify_verdict  # noqa: E402
+
+SUMMARY_PASS = """\
+ ==============================
+  TEST SUMMARY
+   PLANNED:         22
+   EXECUTED:        22
+   TIME_ELAPSED_MS: 3665
+   PASSED:          22
+   FAILED:          0
+=============================="""
+
+SUMMARY_FAIL = SUMMARY_PASS.replace("FAILED:          0",
+                                    "FAILED:          1").replace(
+    "PASSED:          22", "PASSED:          21")
+
+
+def main():
+    """Run the verdict-contract cases."""
+    if len(sys.argv) != 3:
+        print("usage: test_verdict_parser.py <builddir> <arch>")
+        return 2
+    cases = [
+        ("clean pass", SUMMARY_PASS, "ui",
+         (0, "22", "0", "3665ms", "")),
+        ("failing summary stays FAIL", SUMMARY_FAIL, "ui",
+         (1, "21", "1", "3665ms", "")),
+        ("empty log is NO_SUMMARY",
+         "RESULT: QEMU_EXIT (no TEST SUMMARY)", "ui",
+         (1, "0", "0", "0ms", " STATUS: NO_SUMMARY")),
+        ("timeout verdict is TIMEOUT",
+         "RESULT: TIMEOUT (120s, no summary)", "ui",
+         (1, "0", "0", "0ms", " STATUS: TIMEOUT")),
+        ("zero S-lines, timeout", "S: x foo\nRESULT: TIMEOUT", "ui",
+         (1, "0", "0", "0ms", " STATUS: TIMEOUT")),
+        ("expected panic passes",
+         "RESULT: PASS (expected panic: test-main)\n", "testrunner",
+         (0, "0", "0", "0ms", " STATUS: EXPECTED_PANIC_PASS")),
+        ("panic without summary fails",
+         "KERNEL PANIC: test\n", "ui",
+         (1, "0", "0", "0ms", " STATUS: PANIC")),
+        ("stall recovered attaches to pass",
+         SUMMARY_PASS + "STALL-RECOVERED", "ui",
+         (0, "22", "0", "3665ms", " STATUS: STALL-RECOVERED")),
+        ("stall recovered never overrides fail", SUMMARY_FAIL, "ui",
+         (1, "21", "1", "3665ms", "")),
+        ("task_fpu empty is NO_TESTS_REGISTERED",
+         "No tests registered\n", "task_fpu",
+         (0, "0", "0", "0ms", " STATUS: NO_TESTS_REGISTERED")),
+    ]
+    failures = 0
+    for name, text, cls, want in cases:
+        got = classify_verdict(text, cls)
+        if got != want:
+            print("FAIL %s: got %r want %r" % (name, got, want))
+            failures += 1
+    if failures:
+        print("verdict-contract FAILED: %d/%d" % (failures, len(cases)))
+        return 1
+    print("verdict-contract PASSED: %d/%d" % (len(cases), len(cases)))
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/tools/meson/trim_dtb_staged.py b/tools/meson/trim_dtb_staged.py
new file mode 100644
index 000000000..4cca958a0
--- /dev/null
+++ b/tools/meson/trim_dtb_staged.py
@@ -0,0 +1,38 @@
+#!/usr/bin/env python3
+"""Trim a QEMU-dumped DTB and stage the assembler-visible copy (issue #170).
+
+Runs tools/trim_dtb.py (input -> output), then copies the trimmed blob to
+the assembler-visible path (<builddir>/build/virt.trimmed.dtb, which is
+what virt_dtb.S `.incbin`s relative to the build root). One command, so
+the staged copy can never go stale independently of the tracked output.
+
+Usage:
+    trim_dtb_staged.py <dumped> <output> <staged-copy>
+"""
+
+import shutil
+import subprocess
+import sys
+from pathlib import Path
+
+
+def main():
+    """Trim the DTB and stage the assembler-visible copy."""
+    if len(sys.argv) != 4:
+        print("usage: trim_dtb_staged.py <dumped> <output> <staged-copy>")
+        return 2
+    _dumped, output, staged = sys.argv[1], sys.argv[2], sys.argv[3]
+    repo = Path(__file__).resolve().parent.parent.parent
+    subprocess.run(
+        [sys.executable, str(repo / "tools" / "trim_dtb.py"),
+         _dumped, output],
+        check=True,
+    )
+    staged_path = Path(staged)
+    staged_path.parent.mkdir(parents=True, exist_ok=True)
+    shutil.copy2(output, staged_path)
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
