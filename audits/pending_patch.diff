+bool debug_validate_handle(uint64_t caller_id, uint64_t handle) noexcept {
+    uint32_t idx = static_cast<uint32_t>(handle & 0xFFFFFFFFULL);
+    uint32_t gen = static_cast<uint32_t>(handle >> 32);
