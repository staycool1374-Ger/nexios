diff --git a/src/kernel/test/test_block_srv.cpp b/src/kernel/test/test_block_srv.cpp
new file mode 100644
index 000000000..a5fdc213f
--- /dev/null
+++ b/src/kernel/test/test_block_srv.cpp
@@ -0,0 +1,165 @@
+/*
+ * NexIOS RTOS — Development Roadmap / Kernel Core
+ * Copyright (C) 2026 Arnold Hasshold
+ *
