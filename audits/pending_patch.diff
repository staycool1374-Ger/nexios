+        start_idx = window_base_page_;
+    if (end_idx > window_end_page_)
+        end_idx = window_end_page_;
+    for (uint64_t idx = start_idx; idx < end_idx; ++idx) {
+        if (bitmap_test(idx))
+            continue;
+        bitmap_set(idx);
+        owner_set_kernel(idx);
+        --free_pages_;
+    }
