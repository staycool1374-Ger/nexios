+                                                     3));
+    JARVIS_ASSERT_EQ(1ULL, arch::ShootdownBatch::flush_target(self));
+    JARVIS_ASSERT_EQ(k_cap + 1,
+                     arch::ShootdownBatch::applied_for_test());
+    JARVIS_ASSERT_EQ(2ULL, arch::ShootdownBatch::sends_for_test());
     JARVIS_TEST_PASS();
 }
 
