+uint64_t Timer::remaining_ns() {
+    const uint64_t freq = counter_freq_hz_;
+    if (freq == 0) {
+        return 0;
+    }
+    const uint64_t tval = remaining();
+    return (tval / freq) * 1000000000ULL +
+           ((tval % freq) * 1000000000ULL) / freq;
+}
