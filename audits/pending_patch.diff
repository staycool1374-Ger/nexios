+    *plic_priority_reg(IRQ_VIRTIO2) = 1;
+    *plic_priority_reg(IRQ_VIRTIO3) = 1;
+    *plic_priority_reg(IRQ_VIRTIO4) = 1;
     asm volatile("fence iorw, iorw" : : : "memory");
     asm volatile("csrs sie, %0" : : "r"((uint64_t)(1ULL << 9)) : "memory");
