new file mode 100755
index 000000000..3539e845d
--- /dev/null
+++ b/tools/term-srv-parity.exp
@@ -0,0 +1,23 @@
+#!/usr/bin/expect -f
+# term-srv parity capture (issue #51, strangler step b): boot an ISO,
+# run /bin/term-srv-parity.c.elf, capture `S TM ` lines to a file.
+# Args: <iso> <serial_log> <out_filtered> [fat32.img]
+# Delegates to tools/srv-pd-parity.py (QEMU monitor sendkey +
+# file-backed COM1). Raw expect-on-spawn cannot work here: file-backed
+# serial is invisible on the spawn channel, and the spawn pty is not
+# guest input (the shell reads COM1/PS2). The ISO must bake
+# test_class=none (interactive shell).
+set iso [lindex $argv 0]
+set serial_log [lindex $argv 1]
+set out_filtered [lindex $argv 2]
+set fat [lindex $argv 3]
+if {$fat eq ""} { set fat "build/meson-x86_64/packaging/fat32.img" }
+set tmp "build/term-srv-parity/exp-[pid]"
+exec mkdir -p $tmp
+if {[catch {exec python3 tools/srv-pd-parity.py $iso /bin/term-srv-parity.c.elf "S TM " $tmp --fat32 $fat --port 4490} res]} {
+    puts "PARITY-CAPTURE-FAIL $res"
+    exit 1
+}
+exec cp $tmp/com1.log $serial_log
+exec cp $tmp/filtered.txt $out_filtered
+puts "PARITY-CAPTURE-OK $out_filtered"
diff --git a/tools/term-srv-parity.sh b/tools/term-srv-parity.sh
new file mode 100755
index 000000000..0b101b413
--- /dev/null
+++ b/tools/term-srv-parity.sh
@@ -0,0 +1,33 @@
+#!/bin/bash
+# term-srv loopback/parity harness (issue #51, strangler step b).
+# Captures `S TM` lines on OFF (default) + ON ISOs via the proven
+# tools/srv-pd-parity.py harness (QEMU monitor sendkey + file-backed
+# COM1: raw expect-on-spawn observes neither file-backed serial nor
+# guest input), diffs the filtered sets (must be byte-identical:
+# emulation policy is unchanged pre-flip; only the PD exists).
+# Usage: tools/term-srv-parity.sh <off-iso> <on-iso> [fat32.img]
+# Artifacts: build/term-srv-parity/<UTC>/ (serial + filtered + diff).
+# NOTE: both ISOs must bake test_class=none (interactive shell).
+set -u
+OFF_ISO="${1:?usage: term-srv-parity.sh <off-iso> <on-iso> [fat32.img]}"
+ON_ISO="${2:?usage: term-srv-parity.sh <off-iso> <on-iso> [fat32.img]}"
+FAT="${3:-build/meson-x86_64/packaging/fat32.img}"
+UTC=$(date -u +%Y%m%dT%H%M%SZ)
+OUT="build/term-srv-parity/$UTC"
+mkdir -p "$OUT"
+echo "term-srv PARITY $UTC (OFF default vs ON shim)"
+PORT=4490
+for variant in OFF ON; do
+    ISO_VAR="${variant}_ISO"
+    PORT=$((PORT + 1))
+    python3 tools/srv-pd-parity.py "${!ISO_VAR}" /bin/term-srv-parity.c.elf "S TM " \
+        "$OUT/$variant" --fat32 "$FAT" --port "$PORT" || exit 1
+    cp "$OUT/$variant/filtered.txt" "$OUT/filtered-$variant.txt"
+    cp "$OUT/$variant/com1.log" "$OUT/serial-$variant.log"
+done
+if diff -u "$OUT/filtered-OFF.txt" "$OUT/filtered-ON.txt" > "$OUT/diff.txt"; then
+    echo "PARITY-OK: OFF == ON (see $OUT)"
+else
+    echo "PARITY-DIFF: see $OUT/diff.txt"
+    exit 1
+fi
diff --git a/userspace/log-srv.c b/userspace/log-srv.c
new file mode 100644
index 000000000..f11c6a0fd
--- /dev/null
+++ b/userspace/log-srv.c
@@ -0,0 +1,88 @@
+#include <stddef.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <unistd.h>
+#include <string.h>
+#include <syscall.h>
+#include <ipc.h>
+
+#define MSG_DAEMON_READY 0xF0000001
+#define MSG_TYPE_REPLY 0xF0000002
+
+typedef enum {
+    LOG_OP_BIND = 0,
+    LOG_OP_SINK_PUSH = 1,
+    LOG_OP_SINK_DRAIN = 2,
+    LOG_OP_METER = 3,
+    LOG_OP_INJECT_DROP = 4,
+} log_srv_op_t;
+
+struct LogRpc {
+    uint8_t op;
+    uint8_t flags;
+    uint16_t rsvd;
+    uint32_t epoch;
+    uint32_t owner_id;
+    uint32_t owner_gen;
+    uint64_t arg0;
+    uint64_t arg1;
+    uint16_t status_op;
+    uint16_t status;
+    uint32_t rsvd2;
+};
+
+static void log_assert_shape(void) {
+    char check[sizeof(struct LogRpc) <= 48 ? 1 : -1];
+    (void)check;
+}
+
+static unsigned long g_dropped = 0;
+
+int main(void) {
+    log_assert_shape();
+    (void)getpid();
+    ipc_send(1, MSG_DAEMON_READY, NULL, 0, 0);
+
+    static unsigned char rbuf[64];
+    for (;;) {
+        int rc = ipc_recv(rbuf, sizeof(rbuf));
+        if (rc < 0)
+            continue;
+        struct LogRpc req;
+        memset(&req, 0, sizeof(req));
+        unsigned long copy = sizeof(req) < 48 ? sizeof(req) : 48;
+        memcpy(&req, rbuf, copy);
+        if ((unsigned long)rc != req.op)
+            continue; // torn/stale payload: kernel type must match body op
+
+        struct LogRpc rep;
+        memset(&rep, 0, sizeof(rep));
+        rep.op = req.op;
+        rep.epoch = req.epoch;
+        rep.owner_id = req.owner_id;
+        rep.owner_gen = req.owner_gen;
+        rep.status_op = (uint16_t)req.op;
+        switch (req.op) {
+        case LOG_OP_BIND:
+            rep.status = 0;
+            break;
+        case LOG_OP_INJECT_DROP:
+            ++g_dropped;
+            rep.status = 0;
+            break;
+        default:
+            /* Step-a diagnostic shape: sink stays in-kernel. */
+            rep.status = (uint16_t)(uint16_t)-38;
+            break;
+        }
+        (void)g_dropped;
+        // Reply to the requester (owner_id carried in the RPC body):
+        // send_sync_bounded waits on the REQUESTER's own queue with a
+        // sender match, so a reply addressed to PID 1 (init) is a dead
+        // letter and every RPC times out (issue #51 step-b evidence:
+        // live PD + logprobe BIND -ENOSYS). Mirrors the iocd args[0]
+        // requester convention.
+        ipc_send(req.owner_id, MSG_TYPE_REPLY, &rep, sizeof(rep), 0);
+    }
+    return 0;
+}
