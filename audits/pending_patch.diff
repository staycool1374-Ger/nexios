+    0x10000000ULL; // 256 buses * 32 devices * 8 functions * 4KB = 256MB
 
 /// @brief Build ECAM address from BDF + register offset.
 /// ECAM layout: base | (bus << 20) | (device << 15) | (function << 12) | reg
