diff --git a/src/kernel/syscall/syscall_handlers_ipc.cpp b/src/kernel/syscall/syscall_handlers_ipc.cpp
index 4b397b12b..17f38e342 100644
--- a/src/kernel/syscall/syscall_handlers_ipc.cpp
+++ b/src/kernel/syscall/syscall_handlers_ipc.cpp
@@ -149,8 +149,25 @@ uint64_t Syscall::sys_receive(uint64_t, uint64_t arg1, uint64_t arg2,
     return msg.type;
