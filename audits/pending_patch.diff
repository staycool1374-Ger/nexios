+    Scheduler::add_task(*t);
+    Scheduler::reschedule();
+    kernel::test::wait_for_termination_safe(t);
+    Scheduler::drain_zombie_list();
+    JARVIS_ASSERT_EQ(static_cast<size_t>(0), IrqDelivery::occupied_count());
+    JARVIS_TEST_PASS();
