index 000000000..f470cd0d8
--- /dev/null
+++ b/tools/meson/tests/test_flag_parity.py
@@ -0,0 +1,151 @@
+#!/usr/bin/env python3
+"""Per-TU flag parity vs the frozen Makefile manifests (issue #170).
+
+Usage:
+    python3 tools/meson/tests/test_flag_parity.py <builddir> <arch>
+
+Reads every C++ compile command from `ninja -t commands`, strips
+Meson/ninja-injected noise (documented below), normalizes -flto* to
+-flto, and diffs the flag multiset against
+tools/meson/flag-manifest-<arch>.txt. Exits non-zero on any delta.
+
+Allowed deviations (all inert under -nostdinc / shadowed / depfiles):
+  -D_GLIBCXX_ASSERTIONS=1, -D_FILE_OFFSET_BITS=64 (Meson buildtype debug;
+   affect system headers only, never included freestanding)
+  -O0 (Meson debug buildtype; our explicit -Og wins, last -O applies)
+  -fdiagnostics-color=always, -Winvalid-pch (ninja/Meson diagnostics)
+  -MD/-MMD/-MF/-MQ/-MT (ninja depfiles; Make used -MMD -MP, dropped by design)
+  -I<build-root> entries (build-dir scaffolding, not kernel flags)
+  -flto=auto (Meson b_lto spelling; normalized to -flto)
+"""
+
+import subprocess
+import sys
+from pathlib import Path
+
+DROP_PREFIXES = ("-MD", "-MMD", "-MF", "-MQ", "-MT")
+DROP_EXACT = {
+    "-D_GLIBCXX_ASSERTIONS=1",
+    "-D_FILE_OFFSET_BITS=64",
+    "-O0",
+    "-fdiagnostics-color=always",
+    "-Winvalid-pch",
+    "-c",
+}
+
+
+def normalize(tokens):
+    """Filter scaffolding and normalize the LTO spelling."""
+    kept = []
+    skip_next = False
+    for index, token in enumerate(tokens):
+        if skip_next:
+            skip_next = False
+            continue
+        if token in DROP_EXACT:
+            continue
+        if token in ("-I", "-isystem", "-o", "-MF", "-MQ", "-MT"):
+            skip_next = True
+            continue
+        if token.startswith(DROP_PREFIXES):
+            continue
+        if token.startswith("-I"):
+            continue
+        if token == "-o":
+            continue
+        if token.endswith((".cpp", ".c", ".o", ".obj",
+                           ".S", ".s", ".asm", ".nasm")):
+            continue
+        if "++" in token or token.endswith(("gcc", "g++", "cc", "clang++")):
+            if index == 0 or "/" in token:
+                continue
+        if token.startswith("-flto"):
+            kept.append("-flto")
+            continue
+        kept.append(token)
+    return kept
+
+
+def compile_units(builddir):
+    """Yield (language, tokens, input-path) per compile command."""
+    out = subprocess.run(
+        ["ninja", "-t", "commands"],
+        cwd=builddir,
+        capture_output=True,
+        text=True,
+        check=True,
+    )
+    for line in out.stdout.splitlines():
+        if " -c " not in line:
+            continue
+        tokens = line.split()
+        inputs = [t for t in tokens
+                  if t.endswith((".cpp", ".c", ".S", ".s", ".asm", ".nasm"))]
+        if not inputs:
+            continue
+        suffix = inputs[-1].rsplit(".", 1)[-1]
+        lang = "cc" if suffix in ("c", "S", "s", "asm", "nasm") else "cpp"
+        yield lang, tokens, inputs[-1]
+
+
+def load_manifest(arch, lang):
+    """Read the frozen flag set for one arch and language."""
+    name = ("flag-manifest-%s.txt" % arch if lang == "cpp"
+            else "flag-manifest-%s-cc.txt" % arch)
+    path = Path(__file__).resolve().parent.parent / name
+    if not path.exists():
+        return None
+    return sorted(
+        line.strip()
+        for line in path.read_text().splitlines()
+        if line.strip() and not line.startswith("#")
+    )
+
+
+def main():
+    """Compare real per-TU flags against the frozen manifests."""
+    if len(sys.argv) != 3:
+        print("usage: test_flag_parity.py <builddir> <arch>")
+        return 2
+    builddir = Path(sys.argv[1])
+    arch = sys.argv[2]
+    failures = 0
+    checked = {"cpp": 0, "cc": 0}
+    for lang, tokens, path in compile_units(str(builddir)):
+        if "/tools/" in path:
+            continue  # host tooling compiles natively by design
+        expected = load_manifest(arch, lang)
+        if expected is None:
+            continue
+        actual = normalize(tokens)
+        checked[lang] += 1
+        # Identical duplicates (e.g. Meson's own -Wall/-g beside ours) are
+        # harmless scaffolding; missing/extra flags are the real signal.
+        seen = set()
+        dups = sorted({f for f in actual if f in seen or seen.add(f)})
+        actual_set, expected_set = set(actual), set(expected)
+        missing = sorted(expected_set - actual_set)
+        extra = sorted(actual_set - expected_set)
+        if missing or extra:
+            failures += 1
+            print("flag drift in: %s" % " ".join(tokens[-3:]))
+            if missing:
+                print("  missing: %s" % " ".join(missing))
+            if extra:
+                print("  extra:   %s" % " ".join(extra))
+        elif dups:
+            print("note: harmless duplicate flags: %s" % " ".join(dups))
+    total = checked["cpp"] + checked["cc"]
+    if total == 0:
+        print("no compile commands found in %s" % builddir)
+        return 2
+    if failures:
+        print("flag parity FAILED: %d/%d TUs drift" % (failures, total))
+        return 1
+    print("flag parity PASSED: %d TUs match manifests-%s (cpp=%d cc=%d)"
+          % (total, arch, checked["cpp"], checked["cc"]))
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/tools/meson/tests/test_gen_registry.py b/tools/meson/tests/test_gen_registry.py
new file mode 100644
index 000000000..ccea674d9
--- /dev/null
+++ b/tools/meson/tests/test_gen_registry.py
@@ -0,0 +1,97 @@
+#!/usr/bin/env python3
+"""Registry codegen parity vs the Makefile flow (issue #170).
+
+Usage:
+    python3 tools/meson/tests/test_gen_registry.py <builddir> <arch>
+
+Checks:
+  1. The Meson-configured file list (builddir .test-file-list-<arch>)
+     is byte-identical to the Make-order list (same `find` the Makefile
+     uses for this subtree — identical readdir order by construction).
+  2. The Meson-built test_registry.gen.hpp is byte-identical to a
+     reference header produced by running tools/gen_test_registry.py over
+     that list with the same --arch filter.
+
+Any delta means the registry would register a different test set under
+Meson — fail-closed, no boot with a divergent registry.
+"""
+
+import subprocess
+import sys
+import tempfile
+from pathlib import Path
+
+REPO = Path(__file__).resolve().parent.parent.parent.parent
+GEN = REPO / "tools" / "gen_test_registry.py"
+TEST_SRC_DIR = REPO / "src" / "kernel" / "test"
+
+
+def make_order_list():
+    """Replicate the Makefile enumeration for this subtree."""
+    out = subprocess.run(
+        ["find", str(TEST_SRC_DIR), "-maxdepth", "1", "-name", "*.cpp"],
+        capture_output=True,
+        text=True,
+        check=True,
+    )
+    return [line for line in out.stdout.splitlines() if line]
+
+
+def main():
+    """Byte-compare the file list and the generated registry header."""
+    if len(sys.argv) != 3:
+        print("usage: test_gen_registry.py <builddir> <arch>")
+        return 2
+    builddir = Path(sys.argv[1])
+    arch = sys.argv[2]
+    candidates = sorted(builddir.rglob(".test-file-list-%s" % arch))
+    if not candidates:
+        print("no configured file list in %s" % builddir)
+        return 2
+    meson_list_path = candidates[0]
+    meson_list = meson_list_path.read_text(encoding="utf-8").splitlines()
+    lines = make_order_list()
+    # Normalize to repo-relative form for comparison (both absolute here).
+    make_list = [str(Path(p).resolve()) for p in lines]
+    meson_abs = [str((REPO / p).resolve()) if not Path(p).is_absolute() else p
+                 for p in meson_list if p]
+    if meson_abs != make_list:
+        print("file-list drift: meson=%d make=%d" % (len(meson_abs), len(make_list)))
+        only_meson = sorted(set(meson_abs) - set(make_list))
+        only_make = sorted(set(make_list) - set(meson_abs))
+        if only_meson:
+            print("  meson-only: %s" % only_meson[:5])
+        if only_make:
+            print("  make-only: %s" % only_make[:5])
+        order = [p for p in meson_abs if p in make_list]
+        if order != make_list:
+            print("  order differs")
+        return 1
+    headers = sorted(builddir.rglob("test_registry.gen.hpp"))
+    if not headers:
+        print("meson header not built under %s (run meson compile first)"
+              % builddir)
+        return 2
+    meson_header = headers[0]
+    with tempfile.TemporaryDirectory() as tmp:
+        ref_list = Path(tmp) / "file-list.txt"
+        ref_list.write_text("\n".join(make_list) + "\n", encoding="utf-8")
+        ref_header = Path(tmp) / "test_registry.gen.hpp"
+        subprocess.run(
+            [sys.executable, str(GEN), str(TEST_SRC_DIR), str(ref_header),
+             "--file-list", str(ref_list), "--arch", arch],
+            check=True,
+        )
+        built = meson_header.read_bytes()
+        expected = ref_header.read_bytes()
+    if built != expected:
+        print("registry header drift: built=%d bytes reference=%d bytes"
+              % (len(built), len(expected)))
+        return 1
+    print("registry parity PASSED: %d files, %d bytes identical (%s)"
+          % (len(meson_abs), len(built), arch))
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
