new file mode 100644
index 00000000..24c1ac33
--- /dev/null
+++ b/src/kernel/arch/x86_64/hal/pcid.cpp
@@ -0,0 +1,145 @@
+/*
+ * NexIOS RTOS — Development Roadmap / Kernel Core
+ * Copyright (C) 2026 Arnold Hasshold
+ *
