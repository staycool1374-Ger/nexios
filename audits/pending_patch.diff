+        vfs::Vnode *f = vfs::resolve(kCreated);
+        JARVIS_ASSERT(f != nullptr && f->ops != nullptr &&
+                      f->ops->read != nullptr);
+        int64_t rd = f->ops->read(*f, reinterpret_cast<uint8_t *>(got),
