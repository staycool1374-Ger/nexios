+    // loads in the accessors, ensure_bound() and transfer_sector().
+    __atomic_store_n(reinterpret_cast<uint8_t *>(&g_backend),
+                     static_cast<uint8_t>(backend), __ATOMIC_RELAXED);
+    __atomic_store_n(&g_sector_count,
