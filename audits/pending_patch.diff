diff --git a/src/kernel/test/test_libc_verify.cpp b/src/kernel/test/test_libc_verify.cpp
new file mode 100644
index 00000000..8ecbc5a4
--- /dev/null
+++ b/src/kernel/test/test_libc_verify.cpp
@@ -0,0 +1,394 @@
+/*
+ * NexIOS RTOS — Development Roadmap / Kernel Core
+ * Copyright (C) 2026 Arnold Hasshold
+ *
