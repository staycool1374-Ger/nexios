+    Message fill{};
+    fill.sender_id = 0;
+    fill.type = 99;
+    fill.priority = 0;
+    fill.data_size = 0;
+    for (size_t i = 0; i < IPC_MAX_QUEUE_MSG; ++i)
+        self->msg_queue.push(fill);
+
