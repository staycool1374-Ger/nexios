diff --git a/src/kernel/arch/riscv64/syscall_entry.S b/src/kernel/arch/riscv64/syscall_entry.S
index f37958971..637f2e4c5 100644
--- a/src/kernel/arch/riscv64/syscall_entry.S
+++ b/src/kernel/arch/riscv64/syscall_entry.S
@@ -525,21 +525,7 @@ abort_switch:
     # U-path: x2 IS sp, so sp is user_sp from here on — never recompute
     # the frame base from sp again (that faulted: user_sp-296 is not the
     # frame). x6 still holds the base: load t1 directly, then sret.
-    # Balance the entry inc (issue #513: this verbatim resume skipped the
-    # shared tail dec, leaking +1 per uaccess-recovery fault). Saturating
-    # (see 8:) so a pre-existing imbalance cannot drive depth negative.
-    # t0/t2 are dead here (only x6/x2 are live restores on this path).
-    la t0, isr_nesting_depth
-    ld t2, 0(t0)
-    beqz t2, 82f
-    addi t2, t2, -1
-    sd t2, 0(t0)
-    j 83f
-82: la t0, g_depth_sat
-    ld t2, 0(t0)
-    addi t2, t2, 1
-    sd t2, 0(t0)
-83: ld x6, OFF_T1(x6)
+    ld x6, OFF_T1(x6)
     sret
 .Ltrap_park:
     # Issue #513: fault disposition is switch-or-park with no arm
diff --git a/src/kernel/task/scheduler_snapshot.cpp b/src/kernel/task/scheduler_snapshot.cpp
index 8511a01a5..fd73a7632 100644
--- a/src/kernel/task/scheduler_snapshot.cpp
+++ b/src/kernel/task/scheduler_snapshot.cpp
@@ -179,7 +179,11 @@ void Scheduler::restore_state(TaskControlBlock *const *tasks_in,
     // trap time (validate_trap_frame).
     __atomic_store_n(&scheduler_switch_generation[0], (uint64_t)0,
                      __ATOMIC_RELEASE);
-    __atomic_store_n(&isr_nesting_own(), (uint64_t)0, __ATOMIC_RELEASE);
+    // Issue #514: do NOT zero isr_nesting_own here. Depth counts
+    // outstanding trap frames (blocked daemon syscalls/hlts); a teardown
+    // zero between a frame's entry-inc and its exit-dec corrupts the
+    // balance (each later completion decs a slammed-0 toward -1). Depth
+    // is self-consistent live state, never stale per-test state.
     // Issue #242: breaker observation is policy-runtime — a restored test
     // must not inherit the previous test's watch window.
     reset_starvation_breaker();
