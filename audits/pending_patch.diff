diff --git a/meson.build b/meson.build
new file mode 100644
index 000000000..3923ab5a5
--- /dev/null
+++ b/meson.build
@@ -0,0 +1,188 @@
+# NexIOS root build (issue #170). Phase 1: toolchain + flags + probe TU.
+# Full kernel build (sources/link/packaging/tests) lands in Phases 2-5.
+# Make stays authoritative until the Phase 9 cutover.
+
+project('nexios', 'cpp',
+  version : '0.5.6-dev',
+  meson_version : '>=1.12.0',
+  default_options : [
+    'cpp_std=c++20',
+    'buildtype=debug',
+    'b_lto=true',
+    'b_pie=false',
+    'b_staticpic=false',
+    'b_sanitize=none',
+    'b_ndebug=false',
+    # No Meson-injected warning flags: -Wall/-Wextra come from the explicit
+    # per-arch flag lists (byte-mirror of Make). Meson defaults would add
+    # -Wall to C targets where Make has none.
+    'warning_level=0',
+  ])
+
+add_languages('c', required : true)
+
+arch = get_option('arch')
+cpu_family = host_machine.cpu_family()
+arch_from_cpu = {
+  'x86_64' : 'x86_64',
+  'aarch64' : 'aarch64',
+  'riscv64' : 'riscv64',
+}.get(cpu_family, 'unknown')
+assert(arch == arch_from_cpu,
+  'arch option (' + arch + ') must match the cross file cpu_family (' + cpu_family + ')')
+
+# Single Python interpreter for all custom_targets and tests (PATH-resolved,
+# pinned by the operator docs; never apt's 1.3.2).
+py3 = find_program('python3', required : true)
+
+# Shared toolchain programs (issue #170 Phase 3). The C compiler comes
+# from the cross file; objcopy/strip/readelf/as are triplet-resolved.
+# Defined before any flags that invoke tools.
+triplet = arch + '-elf-'
+cc_prog = find_program(triplet + 'gcc', required : true)
+objcopy_prog = find_program(triplet + 'objcopy', required : true)
+arch_readelf = find_program(triplet + 'readelf', required : true)
+arch_strip = find_program(triplet + 'strip', required : true)
+arch_objdump = find_program(triplet + 'objdump', required : false)
+nasm_prog = find_program('nasm', required : arch == 'x86_64')
+
+# --- Common flags: byte-mirror of Makefile CXXFLAGS_COMMON (sans -pipe -MMD -MP;
+# ninja emits its own depfiles). CONFIG_DEFS map 1:1 to config_defs.
+common_flags = [
+  '-std=c++20', '-ffreestanding', '-fno-exceptions', '-fno-rtti',
+  '-nostdlib', '-nostdinc', '-fno-builtin', '-fno-stack-protector',
+  '-fno-threadsafe-statics',
+  '-Wall', '-Wextra', '-Werror',
+  '-ffunction-sections', '-fdata-sections',
+]
+arch_upper = arch.to_upper()
+common_flags += [
+  '-DCONFIG_ARCH_' + arch_upper,
+  '-DNEXIOS_ARCH_NAME=' + arch,
+  '-DPICOLIBC_VERSION_NUM=' + get_option('picolibc_version'),
+]
+foreach def : get_option('config_defs')
+  common_flags += [def]
+endforeach
+
+# --- Arch flags: mirror of the Makefile per-arch blocks.
+arch_flags = []
+if arch == 'x86_64'
+  arch_flags = ['-fno-pie', '-m64', '-mno-red-zone', '-mgeneral-regs-only', '-mcmodel=large']
+elif arch == 'aarch64'
+  arch_flags = ['-march=armv8-a']
+elif arch == 'riscv64'
+  arch_flags = ['-march=rv64imafdc', '-mabi=lp64d', '-mcmodel=medany', '-fno-pie']
+endif
+
+# --- Build-type flags: mirror of debug/release target overrides.
+# -Db_lto=false is the NO_LTO variant (never mix; see .lto-mode marker, Phase 3).
+build_flags = []
+if get_option('buildtype') == 'release'
+  build_flags = ['-g', '-O2', '-fanalyzer', '-DBUILD_TYPE=release']
+  analyzer_suppress = [
+    'analyzer-null-argument', 'analyzer-possible-null-argument',
+    'analyzer-possible-null-dereference', 'analyzer-use-of-uninitialized-value',
+    'analyzer-infinite-loop', 'analyzer-malloc-leak',
+    'analyzer-undefined-behavior-ptrdiff', 'analyzer-out-of-bounds',
+  ]
+  foreach w : analyzer_suppress
+    if cc.has_argument('-Wno-error=' + w)
+      build_flags += ['-Wno-error=' + w]
+    endif
+  endforeach
+else
+  # Single LTO flag source: -Db_lto (Meson emits -flto=auto, semantically
+  # -flto; the parity test normalizes -flto* to -flto). NO_LTO = -Db_lto=false.
+  build_flags = ['-g', '-Og', '-DCONFIG_DEBUG', '-fno-omit-frame-pointer',
+    '-fstack-usage', '-DBUILD_TYPE=debug']
+endif
+
+add_project_arguments(common_flags + arch_flags + build_flags,
+  language : 'cpp')
+
+# Profiling/coverage modes (issue #170 Phase 6; x86_64 only, like Make).
+# Dedicated builddirs are mandatory here (flags change every object).
+# gcov mode mirrors COVERAGE_LINE_FLAGS (absolute-path .gcno for host-side
+# reconstruction); func/sampling modes mirror COVERAGE_FUNC_FLAGS.
+if host_machine.cpu_family() == 'x86_64'
+  gcov_lib = run_command(cc_prog, '--print-file-name=libgcov.a',
+    check : false).stdout().strip()
+  if get_option('profile_mode') == 'gcov'
+    add_project_arguments(
+      ['-fprofile-arcs', '-ftest-coverage', '-fprofile-abs-path'],
+      language : ['cpp', 'c'])
+  elif get_option('profile_mode') in ['sampling', 'coverage_func', 'coverage_line']
+    add_project_arguments(
+      ['-finstrument-functions',
+       '-finstrument-functions-exclude-file-list=src/kernel/gcov/,gcov_handler.cpp'],
+      language : ['cpp', 'c'])
+  endif
+endif
+
+# C flags: byte-mirror of Makefile CCFLAGS (minus -pipe -MMD -MP; ninja
+# depfiles). Applied to ALL C targets (kernel .S, libc, userspace),
+# exactly as Make applies CCFLAGS everywhere.
+cc_base_flags = ['-static', '-nostdlib', '-ffreestanding', '-O2',
+  '-ffunction-sections', '-fdata-sections']
+if arch == 'x86_64'
+  cc_arch_flags = ['-m64']
+elif arch == 'aarch64'
+  cc_arch_flags = []
+else
+  cc_arch_flags = ['-DCONFIG_ARCH_RISCV64', '-mcmodel=medany', '-fno-pie']
+endif
+if arch == 'aarch64'
+  cc_includes = ['-I' + meson.project_source_root() / 'src',
+    '-I' + meson.project_source_root() / 'src' / 'lib']
+else
+  cc_includes = []
+endif
+if get_option('buildtype') == 'release'
+  cc_build_flags = []
+else
+  cc_build_flags = ['-g', '-Og', '-DCONFIG_DEBUG', '-fno-omit-frame-pointer']
+endif
+add_project_arguments(cc_base_flags + cc_arch_flags + cc_includes + cc_build_flags,
+  language : 'c')
+
+kernel_includes = include_directories('src', 'src/lib')
+
+# Phase 1 probe: one real TU under the exact kernel flag set (incl. -Werror).
+# Proves cross-file resolution + flag acceptance per arch. The full kernel
+# build lands in src/meson.build (Phase 3).
+phase1_probe = static_library('phase1_probe', 'src/lib/version.cpp',
+  include_directories : kernel_includes)
+
+# QEMU virt DTB for aarch64 (Phase 3): dumped from QEMU, trimmed, embedded
+# via virt_dtb.S `.incbin "build/virt.trimmed.dtb"` — the path resolves
+# from the build root. custom_target outputs must be flat, so the trim
+# script writes the tracked flat output AND the assembler-visible copy at
+# <builddir>/build/virt.trimmed.dtb as one atomic step (same command, so
+# the copy can never go stale independently).
+# Defined BEFORE the subdir() calls: src/meson.build consumes the trim.
+if arch == 'aarch64'
+  qemu_aarch64 = find_program('qemu-system-aarch64', required : true)
+  virt_dtb_raw = custom_target('virt-dtb-dump',
+    output : 'virt.dtb',
+    command : [qemu_aarch64, '-machine', 'virt,dumpdtb=@OUTPUT@',
+      '-cpu', 'cortex-a72', '-m', '256M'],
+  )
+  virt_dtb_trimmed = custom_target('virt-dtb-trim',
+    input : virt_dtb_raw,
+    output : 'virt.trimmed.dtb',
+    command : [py3, meson.project_source_root() / 'tools' / 'meson' / 'trim_dtb_staged.py',
+      '@INPUT@', '@OUTPUT@',
+      meson.project_build_root() / 'build' / 'virt.trimmed.dtb'],
+  )
+endif
+
+# Packaging (userspace/libc/initrd/images) before src: the kernel link
+# consumes blob objects defined there (link_with/objects cross-subdir).
+subdir('packaging')
+
+# Test registry codegen (Phase 2). Full source discovery in Phase 3.
+subdir('src')
+
+# Meson test map: QEMU suites + host suites (Phase 4).
+subdir('tests')
diff --git a/meson.options b/meson.options
new file mode 100644
index 000000000..99397e262
--- /dev/null
+++ b/meson.options
@@ -0,0 +1,36 @@
+# Meson options for NexIOS (issue #170). Backward-compatible names only;
+# kernel behavior is unchanged — these select build configuration.
+
+option('arch', type : 'combo',
+  choices : ['x86_64', 'aarch64', 'riscv64'],
+  value : 'x86_64',
+  description : 'Target architecture (must match the --cross-file)')
+
+option('test_class', type : 'string',
+  value : 'none',
+  description : 'Test class baked into test-config.txt (Phase 4 harness)')
+
+option('config_defs', type : 'array',
+  value : [],
+  description : 'Extra -D overrides, e.g. -Dconfig_defs=-DCONFIG_DEADLINE_ACTION=3')
+
+option('external_test_dir', type : 'string',
+  value : '',
+  description : 'External test source dir (selftest subset rule, Phase 3)')
+
+option('profile_mode', type : 'combo',
+  choices : ['none', 'sampling', 'gcov', 'coverage_func', 'coverage_line'],
+  value : 'none',
+  description : 'Coverage/profiling mode (host analysis only, Phase 6)')
+
+option('qemu_uefi', type : 'string',
+  value : '',
+  description : 'OVMF firmware path override (empty = auto-detect)')
+
+option('picolibc_version', type : 'string',
+  value : '1.8.12',
+  description : 'Picolibc version pin (pp-number, unquoted -D)')
+
+option('clang_tidy', type : 'boolean',
+  value : false,
+  description : 'Enable non-blocking clang-tidy run_target (Phase 6)')
diff --git a/packaging/meson.build b/packaging/meson.build
new file mode 100644
index 000000000..3e6fe7ad0
--- /dev/null
+++ b/packaging/meson.build
@@ -0,0 +1,225 @@
+# Userspace, libc, initrd, images (issue #170 Phase 3 + Phase 5).
+#
+# Mirrors mk/rules.mk byte-for-byte: in-tree libc archive, userspace ELF
+# links (crt0 first, -Wl,-z,max-page-size), picolibc sysroot + glue +
+# verify program (x86_64 only), initrd tree + cpio (stage_initrd.py),
+# FAT32 image (mkfat32img.py). The kernel link consumes the staged
+# artifacts by absolute builddir path (ninja unifies producer/consumer
+# across subdirs); src/meson.build objcopy steps rename symbols to the
+# exact _binary_* names the kernel references.
+
+# CC flags mirror Make CCFLAGS (sans -pipe -MMD -MP: ninja emits its own
+# depfiles). -I dirs are per-target below, mirroring each Make rule
+# exactly (-I order matters: sysroot must precede src/libc for picolibc
+# targets so the sysroot errno.h wins over the in-tree one).
+cc_usr_flags = cc_base_flags + cc_arch_flags + cc_build_flags
+libc_includes = ['-I', meson.project_source_root() / 'src' / 'libc']
+crt0_path = meson.project_build_root() / 'src' / 'crt0.o'
+
+# --- In-tree libc archive (mirrors LIBC_A) ---
+libc_sources = []
+_libc_find = run_command('find',
+  meson.project_source_root() / 'src' / 'libc',
+  '-name', '*.c', '-o', '-name', '*.S',
+  check : true)
+foreach s : _libc_find.stdout().strip().split('\n')
+  if s != ''
+    libc_sources += [s]
+  endif
+endforeach
+libc_a = static_library('c', libc_sources,
+  include_directories : include_directories('../src/libc'),
+  c_args : cc_usr_flags,
+  # No LTO on libc objects: Make CCFLAGS never carry -flto
+  # (LTO lives in debug CXXFLAGS/LDFLAGS only).
+  override_options : ['b_lto=false'],
+  install : false,
+)
+
+# --- Userspace discovery (mirrors USERSPACE_SRC; picolibc separate) ---
+_user_find = run_command('find', meson.project_source_root() / 'userspace',
+  '-path', meson.project_source_root() / 'userspace' / 'picolibc', '-prune',
+  '-o', '-name', '*.c', '-print',
+  '-o', '-name', '*.S', '-print',
+  check : true)
+userspace_srcs = []
+foreach s : _user_find.stdout().strip().split('\n')
+  if s != ''
+    userspace_srcs += [s]
+  endif
+endforeach
+
+# Root vs /bin split (issue #274): names must match the stage_initrd
+# root copy list exactly.
+_root_names = ['hey.c.elf', 'nullderef.c.elf', 'prime.c.elf']
+
+# --- Userspace ELF links (mirror userspace/%.c.elf + %.S.elf) ---
+root_elf_targets = []
+bin_elf_targets = []
+foreach src : userspace_srcs
+  parts = src.split('/')
+  out_name = parts[parts.length() - 1] + '.elf'
+  # Probes with explicit link+strip targets below are skipped here to
+  # avoid duplicate target names: errno_probe on x86_64 (embedded for
+  # the Ring-3 TLS test), fork-marker on aarch64/riscv64 (embedded for
+  # the EL0/U-mode smoke tests) — mirroring mk/rules.mk, where each
+  # probe is built only on the arch that embeds it.
+  if arch == 'x86_64' and out_name == 'errno_probe.c.elf'
+    continue
+  endif
+  if (arch == 'aarch64' or arch == 'riscv64') and out_name == 'fork-marker.c.elf'
+    continue
+  endif
+  if src.endswith('.S')
+    # Freestanding .S: bare link, no crt0/libc (like the %.S.elf rule).
+    elf = custom_target(out_name,
+      input : files(src),
+      output : out_name,
+      command : [cc_prog] + cc_usr_flags + ['-o', '@OUTPUT@', '@INPUT@'],
+      build_by_default : true)
+  else
+    # C: crt0 first, in-tree libc, max-page-size (like the %.c.elf rule).
+    # Input order IS link order (crt0, objects, archive); '@INPUT@'
+    # expands in order so no indexed form is needed.
+    elf = custom_target(out_name,
+      input : [crt0_path, files(src), libc_a],
+      output : out_name,
+      command : [cc_prog] + cc_usr_flags + libc_includes
+        + ['-Wl,-z,max-page-size=0x1000', '-o', '@OUTPUT@', '@INPUT@'],
+      build_by_default : true)
+  endif
+  if out_name in _root_names
+    root_elf_targets += [elf]
+  else
+    bin_elf_targets += [elf]
+  endif
+endforeach
+
+# --- Picolibc sysroot + glue + verify program (x86_64 only, like Make) ---
+if arch == 'x86_64'
+  sysroot_stamp = custom_target('picolibc-sysroot',
+    output : 'sysroot-stamp',
+    command : [py3, files('../tools/meson/run_checks.py'), 'picolibc'],
+    build_by_default : false,
+  )
+  sysroot_inc = meson.project_source_root() / 'build' / 'picolibc' / 'sysroot' / 'include'
+  sysroot_lib = meson.project_source_root() / 'build' / 'picolibc' / 'sysroot' / 'lib'
+  picolibc_glue = custom_target('picolibc-glue-obj',
+    input : files('../userspace/picolibc/nexios_glue.c'),
+    output : 'nexios_glue.o',
+    command : [cc_prog] + cc_usr_flags
+      + ['-I', sysroot_inc] + libc_includes + ['-c', '@INPUT@', '-o', '@OUTPUT@'],
+    depends : [sysroot_stamp],
+    build_by_default : false,
+  )
+  picolibc_stubs = custom_target('picolib_stubs.o',
+    input : files('../src/libc/picolib_stubs.c'),
+    output : 'picolib_stubs.o',
+    command : [cc_prog] + cc_usr_flags + libc_includes + ['-c', '@INPUT@', '-o', '@OUTPUT@'],
+    build_by_default : false,
+  )
+  picolibc_errno = custom_target('errno.o',
+    input : files('../src/libc/errno.c'),
+    output : 'errno.o',
+    command : [cc_prog] + cc_usr_flags + libc_includes + ['-c', '@INPUT@', '-o', '@OUTPUT@'],
+    build_by_default : false,
+  )
+  verify_elf = custom_target('libc_verify.c.elf',
+    input : [crt0_path, files('../userspace/picolibc/libc_verify.c'),
+             picolibc_glue, picolibc_stubs, picolibc_errno],
+    output : 'libc_verify.c.elf',
+    # NOTE: no -I src/libc here (unlike the generic userspace rule):
+    # libc_verify.c uses picolibc headers only, and the in-tree
+    # src/libc/stdarg.h stub shadows gcc's complete stdarg.h, breaking
+    # picolibc stdio.h (__gnuc_va_list). Verified: sysroot-only compiles
+    # clean; adding src/libc reproduces the failure identically under
+    # verbatim Make flags (pre-existing latent header conflict, not a
+    # Meson regression — Make only passes via its stale committed .elf).
+    command : [cc_prog] + cc_usr_flags
+      + ['-I', sysroot_inc, '-o', '@OUTPUT@', '@INPUT@',
+          '-L', sysroot_lib, '-lc', '-lm'],
+    build_by_default : true,
+  )
+  # Stripped copy for embedding (tmpfs 64 KiB cap; mirrors Make rule).
+  verify_stripped = custom_target('libc_verify_stripped.elf',
+    input : verify_elf,
+    output : 'libc_verify_stripped.elf',
+    command : ['sh', '-c', 'cp "$1" "$2" && exec "$0" "$2"',
+               arch_strip, '@INPUT@', '@OUTPUT@'],
+    build_by_default : true,
+  )
+  # Errno probe: same link shape, then stripped for embedding.
+  # Built explicitly (not via the generic loop) so the stripped variant
+  # has a stable target handle for the objcopy step in src/meson.build.
+  # Staged to /bin unstripped, like Make's INITRD_BIN_ELF.
+  errno_elf = custom_target('errno_probe.c.elf',
+    input : [crt0_path, files('../userspace/errno_probe.c'), libc_a],
+    output : 'errno_probe.c.elf',
+    command : [cc_prog] + cc_usr_flags + libc_includes
+      + ['-Wl,-z,max-page-size=0x1000',
