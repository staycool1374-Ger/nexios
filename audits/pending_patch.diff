+    JARVIS_ASSERT(VMM::unmap_page_in_pml4_err(kVa, pml4) ==
+                  errors::VMM_ERR_OK);
+    JARVIS_ASSERT(VMM::virt_to_phys_in_pml4(kVa, pml4) == 0);
+    JARVIS_ASSERT(VMM::unmap_page_in_pml4_err(kVa, pml4) ==
