+    JARVIS_ASSERT_EQ(1ULL, s_wake_flags[0]);
+    JARVIS_ASSERT_EQ(0ULL, s_wake_flags[1]);
+    JARVIS_ASSERT_EQ(0ULL, s_wake_flags[2]);
