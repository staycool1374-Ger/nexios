+    req.data_size = 0;
+    bool ok = IPC::send_sync(peer->id, req, reply);
+    JARVIS_ASSERT(!ok);
+
+    Message rest{};
+    JARVIS_ASSERT(me->msg_queue.pop(rest));
+    JARVIS_ASSERT(rest.type == 310ULL);
+    JARVIS_ASSERT(rest.sender_id == decoy_id);
+    JARVIS_ASSERT(me->msg_queue.is_empty());
