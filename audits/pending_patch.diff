index 00000000..3fd44e70
--- /dev/null
+++ b/src/kernel/test/test_smp_madt.cpp
@@ -0,0 +1,206 @@
+/*
+ * NexIOS RTOS — SMP bring-up (Phase B1)
+ * Copyright (C) 2026 Arnold Hasshold
+ *
