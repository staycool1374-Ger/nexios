+        return 0;
+    }
+#else
+    if (g_backend == BLK_BACKEND_VIRTIO_MMIO) {
+        if (virtio_transfer(1, lba))
+            return -BLK_EIO;
+        return 0;
+    }
+#endif
+    return -BLK_ENOSYS;
+}
