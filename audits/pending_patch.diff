+#endif
+    return -BLK_ENOSYS;
+}
+
+static int blk_do_write(uint64_t lba) {
+    if (g_backend == BLK_BACKEND_NONE || g_sectors == 0)
+        return -BLK_EIO;
+    if (lba >= g_sectors)
