+namespace {
+
+int g_pass = 0;
+int g_fail = 0;
+
+#define CHECK(cond)                                                            \
+    do {                                                                       \
+        if (cond) {                                                            \
+            ++g_pass;                                                          \
+        } else {                                                               \
+            ++g_fail;                                                          \
+            std::printf("FAIL %s:%d: %s\n", __FILE__, __LINE__, #cond);        \
+        }                                                                      \
+    } while (0)
