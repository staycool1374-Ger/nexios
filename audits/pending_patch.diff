+    JARVIS_ASSERT_FMT(leaf & (1ULL << 54), "kernel PTE UXN not set: 0x%lx",
+                      leaf);
+
+    auto unmap_result = arch::ArchPageTable::unmap_page(TEST_VA);
+    JARVIS_ASSERT(unmap_result.ok());
