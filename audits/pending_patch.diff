diff --git a/src/kernel/test/test_smp_sched.cpp b/src/kernel/test/test_smp_sched.cpp
new file mode 100644
index 00000000..6fd57174
--- /dev/null
+++ b/src/kernel/test/test_smp_sched.cpp
@@ -0,0 +1,261 @@
+/*
