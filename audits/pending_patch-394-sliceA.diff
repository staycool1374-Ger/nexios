++/// @file fb_backing.cpp
++/// @brief Boot-time PMM-backed framebuffer store (issue #394).
++
++#include <kernel/driver/fb_backing.hpp>
++
++#if !defined(CONFIG_ARCH_X86_64)
++
++#include <kernel/arch/io.hpp>
++#include <kernel/memory/pmm.hpp>
++#include <constants.hpp>
++#include <string.hpp>
