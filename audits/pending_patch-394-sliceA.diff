+            dirty_y1_ = 0;
+        }
+    }
+#endif
+}
+
+void Framebuffer::invalidate() {
+#if !defined(CONFIG_ARCH_X86_64)
+    dirty_y0_ = 0;
+    dirty_y1_ = info_.height;
+#endif
