index 000000000..22d39cc88
--- /dev/null
+++ b/src/kernel/input/serial_input.cpp
@@ -0,0 +1,206 @@
+/*
+ * NexIOS RTOS — Development Roadmap / Kernel Core
+ * Copyright (C) 2026 Arnold Hasshold
+ *
