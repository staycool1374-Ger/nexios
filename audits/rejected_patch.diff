diff --git a/src/kernel/arch/riscv64/syscall_entry.S b/src/kernel/arch/riscv64/syscall_entry.S
--- a/src/kernel/arch/riscv64/syscall_entry.S
+++ b/src/kernel/arch/riscv64/syscall_entry.S
@@ -74,6 +74,8 @@
 41:
     # from_u: sscratch holds user-t0; x2 still holds the user sp.
-    # Load the kstack top straight into sp (x2 untouched).
-    la sp, scheduler_load_kstack_top
-    ld sp, 0(sp)
+    # Load the kstack top into sp via dead t0 (t0 holds the discardable
+    # SPP==0 test result; user-t0 is parked in sscratch).  x2 stays live
+    # until its OFF_SP save below — `la sp` would destroy the user sp.
+    la t0, scheduler_load_kstack_top
+    ld sp, 0(t0)
     addi sp, sp, -SAVE_SIZE
