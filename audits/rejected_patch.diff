diff --git a/src/kernel/time/timer_wheel.cpp b/src/kernel/time/timer_wheel.cpp
--- a/src/kernel/time/timer_wheel.cpp
+++ b/src/kernel/time/timer_wheel.cpp
@@ -460,6 +460,12 @@ bool TimerWheel::arm(uint32_t cpu, uint64
     if (cpu >= CONFIG_MAX_CPUS || callback == nullptr || out == nullptr) {
         return false;
     }
+    // SIL3 fail-closed (audit issue #17): production services only the BSP
+    // wheel — Scheduler::on_tick() returns early for APs and ap_tick() has
+    // no TimerWheel hook (spec section 3.4.4 dispatch-only). An armed AP
+    // timer would report success yet never expire, so reject it outright
+    // until AP servicing lands.
+    if (cpu != 0) {
+        return false;
+    }
     sync::IrqSpinLockGuard guard(lock_);
     ensure_init_locked();
     CpuWheel& wheel = wheels_[cpu];
diff --git a/src/kernel/time/timer_wheel.hpp b/src/kernel/time/timer_wheel.hpp
--- a/src/kernel/time/timer_wheel.hpp
+++ b/src/kernel/time/timer_wheel.hpp
@@ -676,7 +676,8 @@ class TimerWheel {
     /// @brief Arm a one-shot expiry (O(1)).
     /// Fail-closed: false on invalid cpu, null callback/context-out,
     /// or a full wheel (caller keeps its fallback; no eviction).
-    /// @param cpu Owning CPU index (< CONFIG_MAX_CPUS).
+    /// @param cpu Owning CPU index; must be 0 (BSP). Non-BSP CPUs are
+    /// rejected: production never services their wheels (AP dispatch-only).
     /// @param expiry_ns Absolute expiry in monotonic ns (#16 clock).
     /// @param callback Expiry callback (non-null).
     /// @param context Opaque callback context (carries owner identity).
