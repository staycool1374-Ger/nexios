diff --git a/src/kernel/task/deadline_list.cpp b/src/kernel/task/deadline_list.cpp
--- a/src/kernel/task/deadline_list.cpp
+++ b/src/kernel/task/deadline_list.cpp
@@ -71,7 +71,16 @@ void DeadlineList::remove(TaskControlBlock &t) noexcept {
     }
 
     TaskControlBlock *cur = head_;
-    while (cur && cur != &t)
+    // Bounded walk (issue #297, mirrors insert): insert() routes every call
+    // through this scan first, so an unbounded walk here would hang before
+    // insert's own trip-count guard on a cyclic list. Fail stop instead.
+    size_t trips = 0;
+    while (cur && cur != &t) {
         cur = cur->dl_next_;
+        if (++trips > size_) {
+            ENSURE(false && "deadline list cycle detected");
+            return;
+        }
+    }
     if (!cur)
         return;
 
