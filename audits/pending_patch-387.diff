diff --git a/src/kernel/arch/riscv64/hal/memmap.hpp b/src/kernel/arch/riscv64/hal/memmap.hpp
new file mode 100644
index 000000000..5fdf78356
--- /dev/null
+++ b/src/kernel/arch/riscv64/hal/memmap.hpp
@@ -0,0 +1,34 @@
+#pragma once
+
+#include <types.hpp>
+#include <constants.hpp>
+
+/// @brief RISC-V 64 QEMU virt memory-map literals (issue #387: single
+/// arch-owned source — the kernel and the arch tests share these,
+/// never raw address literals).
+/// @note QEMU virt: RAM starts at 0x80000000. The HHDM RAM window maps
+///       PA 0x80000000-0x8FFFFFFF as 128 x 2 MiB block leaves under one
+///       L0 slot (boot.S). Kernel image + initrd + boot reservations
+///       split L0-slot blocks L1[1..5] at boot (#376 harden); L1[6]
+///       (boot stack slack) and L1[7] (boot stack) are boot-reserved —
+///       scratch windows must live at L1[8] and above.
+namespace arch {
+
+/// @brief QEMU virt DRAM base (physical).
+inline constexpr uint64_t RISCV_DRAM_BASE = 0x80000000ULL;
+/// @brief Sv39 L1 block size (2 MiB) — the HHDM window granularity.
+inline constexpr uint64_t RISCV_L1_BLOCK_SIZE = 0x200000ULL;
+/// @brief Sv39 L1 block index shift (log2 of the block size).
+inline constexpr unsigned RISCV_L1_BLOCK_SHIFT = 21;
+/// @brief Page-table index geometry: 512 entries per level (L0 shift 30).
+inline constexpr unsigned RISCV_L0_SHIFT = 30;
+inline constexpr uint64_t RISCV_TABLE_INDEX_MASK = 0x1FFULL;
+/// @brief Base virtual address of the HHDM RAM window.
+inline constexpr uint64_t RISCV_HHDM_RAM_BASE = HHDM_OFFSET + RISCV_DRAM_BASE;
+/// @brief L0 slot covering the HHDM RAM window (derivation pinned: any
+///        HHDM/DRAM move breaks the assert here, not in a test).
+inline constexpr size_t RISCV_HHDM_RAM_L0 =
+    static_cast<size_t>((RISCV_HHDM_RAM_BASE >> 30) & 0x1FF);
+static_assert(RISCV_HHDM_RAM_L0 == 258, "HHDM RAM window L0 slot moved");
+
+} // namespace arch
diff --git a/src/kernel/arch/riscv64/hal/uart.hpp b/src/kernel/arch/riscv64/hal/uart.hpp
new file mode 100644
index 000000000..0f43ee275
--- /dev/null
+++ b/src/kernel/arch/riscv64/hal/uart.hpp
@@ -0,0 +1,27 @@
+#pragma once
+
+#include <types.hpp>
+
+/// @brief RISC-V 64 QEMU virt 16550A UART register literals (issue #387:
+///        single arch-owned source — the driver and the arch tests share
+///        these, never raw address literals).
+/// @note Raw physical address, directly dereferenceable in S-mode (riscv64
+///       low half is identity-mapped — same precedent as the PLIC
+///       accessors).  Divisor pre-initialized by OpenSBI/QEMU (issue #247).
+namespace arch {
+
+/// @brief UART0 MMIO base (QEMU virt machine).
+inline constexpr uint64_t UART0_BASE = 0x10000000ULL;
+/// @brief 16550A register offsets from UART0_BASE.
+inline constexpr uint64_t UART_RBR_OFF = 0; // RX buffer (read)
+inline constexpr uint64_t UART_IER_OFF = 1; // interrupt enable
+inline constexpr uint64_t UART_LCR_OFF = 3; // line control
+inline constexpr uint64_t UART_MCR_OFF = 4; // modem control
+inline constexpr uint64_t UART_LSR_OFF = 5; // line status
+/// @brief Line-status bits.
+inline constexpr uint8_t UART_LSR_DATA_READY = 0x01; // RX data available
+inline constexpr uint8_t UART_LSR_TEMT = 0x40;      // TX holding reg empty
+/// @brief Modem-control loopback bit (test-only loopback control).
+inline constexpr uint8_t UART_MCR_LOOPBACK = 0x10;
+
+} // namespace arch
