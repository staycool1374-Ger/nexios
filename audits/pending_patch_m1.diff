+/// @brief Drain a dying queue's blocked-senders list (M1/F7).
+void IPC::wake_senders_of(MessageQueue &dying_q) noexcept {
+    // Two-phase mirror of wake_sender's pop: unlink under q.lock_, wake
+    // outside (set_task_ready takes scheduler_lock_ internally).  The
+    // ~MessageQueue drain stays as the second line of defence for paths
+    // that never reach the death funnel.
+    for (uint64_t i = 0; i < CONFIG_MAX_TASKS; ++i) {
+        TaskControlBlock *task = nullptr;
+        {
+            SpinLockGuard<sync::SpinLock> guard(dying_q.lock_);
+            if (!dying_q.blocked_senders_head)
+                return;
+            task = dying_q.blocked_senders_head;
+            dying_q.blocked_senders_head = task->blocked_next;
+            if (!dying_q.blocked_senders_head)
+                dying_q.blocked_senders_tail = nullptr;
+            task->blocked_next = nullptr;
+            task->blocked_on_queue = nullptr;
+        }
+        // §12.1: never feed a dead TCB to set_task_ready.
+        if (task->state != TaskState::TERMINATED &&
+            task->state != TaskState::REAPED) {
+            Scheduler::set_task_ready(*task);
+            task->remaining_ticks = task->period_ticks;
+        }
+    }
+    // Bounded by CONFIG_MAX_TASKS (the list is built from live TCBs):
+    // a cap hit means pathological fan-in; the deferred ~MessageQueue
+    // path drains the rest.  Warn, never panic on a reachable condition.
+    kernel::Logger::warn("ipc: wake_senders_of cap hit (dying q=%p)",
+                         static_cast<const void *>(&dying_q));
+}
