+    JARVIS_ASSERT_EQ(1ULL, mk_death::scratch_restarts_of("qe_mk1"));
+    auto *task2 = Scheduler::find_task(pid2);
+    JARVIS_ASSERT(task2 != nullptr);
+    Scheduler::terminate(*daemon_task, 0);
+    test::terminate_if_live(task2);
