#!/usr/bin/expect -f
# Live acceptance for #288 (monstat) + #292 (drill-down detail view).
# Usage: expect -f tools/verify-288.exp run-debug-mode
set timeout 600
eval spawn make $argv
expect {
    -re {\$ $} { puts "VERIFY: prompt reached" }
    timeout { puts "VERIFY: TIMEOUT waiting for prompt"; exit 1 }
    eof { puts "VERIFY: EOF before prompt"; exit 1 }
}
send "monstat\r"
expect {
    -re {ID.*NAME.*UTIL.*STK_LO.*STUCK.*DL_OK} { puts "VERIFY: header present" }
    timeout { puts "VERIFY: TIMEOUT waiting monstat header"; exit 1 }
    eof { puts "VERIFY: EOF waiting monstat header"; exit 1 }
}
expect {
    -re {Task id} { puts "VERIFY: drill-down prompt present" }
    timeout { puts "VERIFY: TIMEOUT waiting task-id prompt"; exit 1 }
    eof { puts "VERIFY: EOF waiting task-id prompt"; exit 1 }
}
send "\r"
expect {
    -re {\$ $} { puts "VERIFY: empty input aborts cleanly" }
    timeout { puts "VERIFY: TIMEOUT after empty abort"; exit 1 }
    eof { puts "VERIFY: EOF after empty abort"; exit 1 }
}
send "monstat 1\r"
expect {
    -re {Task 1} { puts "VERIFY: detail screen for id 1" }
    timeout { puts "VERIFY: TIMEOUT waiting detail screen"; exit 1 }
    eof { puts "VERIFY: EOF waiting detail screen"; exit 1 }
}
expect {
    -re {watchdog:} { puts "VERIFY: watchdog section present" }
    timeout { puts "VERIFY: TIMEOUT waiting watchdog section"; exit 1 }
    eof { puts "VERIFY: EOF waiting watchdog section"; exit 1 }
}
expect {
    -re {\$ $} { puts "VERIFY: detail done" }
    timeout { puts "VERIFY: TIMEOUT after detail"; exit 1 }
    eof { puts "VERIFY: EOF after detail"; exit 1 }
}
send "monstat user\r"
expect {
    -re {Task .*\(} { puts "VERIFY: user detail screen" }
    timeout { puts "VERIFY: TIMEOUT waiting user detail"; exit 1 }
    eof { puts "VERIFY: EOF waiting user detail"; exit 1 }
}
expect {
    -re {\$ $} { puts "VERIFY: user detail done" }
    timeout { puts "VERIFY: TIMEOUT after user detail"; exit 1 }
    eof { puts "VERIFY: EOF after user detail"; exit 1 }
}
send "monstat 99999\r"
expect {
    -re {no such task} { puts "VERIFY: unknown id rejected" }
    timeout { puts "VERIFY: TIMEOUT waiting no-such-task"; exit 1 }
    eof { puts "VERIFY: EOF waiting no-such-task"; exit 1 }
}
send "monstat abc\r"
expect {
    -re {invalid id} { puts "VERIFY: non-numeric id rejected" }
    timeout { puts "VERIFY: TIMEOUT waiting invalid-id"; exit 1 }
    eof { puts "VERIFY: EOF waiting invalid-id"; exit 1 }
}
send "monstat a b\r"
expect {
    -re {Usage: monstat} { puts "VERIFY: usage on extra args" }
    timeout { puts "VERIFY: TIMEOUT waiting usage line"; exit 1 }
    eof { puts "VERIFY: EOF waiting usage line"; exit 1 }
}
send "loadelf burn.c.elf\r"
puts "VERIFY: load requested, settling for the background load..."
sleep 10
send "runelf\r"
expect {
    -re {Started task} { puts "VERIFY: burner started" }
    timeout { puts "VERIFY: TIMEOUT waiting burner start"; exit 1 }
    eof { puts "VERIFY: EOF waiting burner start"; exit 1 }
}
send "monstat user\r"
expect {
    -re {exec_ns=} { puts "VERIFY: live user task has exec stats" }
    timeout { puts "VERIFY: TIMEOUT waiting live user detail"; exit 1 }
    eof { puts "VERIFY: EOF waiting live user detail"; exit 1 }
}
expect {
    -re {\$ $} { puts "VERIFY: live user detail done" }
    timeout { puts "VERIFY: TIMEOUT after live user detail"; exit 1 }
    eof { puts "VERIFY: EOF after live user detail"; exit 1 }
}
puts "VERIFY: waiting for the burner to exit (post-mortem check)..."
set found 0
for {set i 0} {$i < 15} {incr i} {
    sleep 20
    send "monstat user\r"
    expect {
        -re {POST-MORTEM} { set found 1; break }
        -re {\$ $} { puts "VERIFY: still live, waiting..." }
        timeout { puts "VERIFY: TIMEOUT polling post-mortem"; exit 1 }
        eof { puts "VERIFY: EOF polling post-mortem"; exit 1 }
    }
}
if {!$found} { puts "VERIFY: burner never exited in 300s"; exit 1 }
puts "VERIFY: post-mortem record present"
expect {
    -re {exit=0} { puts "VERIFY: post-mortem exit code 0" }
    timeout { puts "VERIFY: TIMEOUT waiting exit code"; exit 1 }
    eof { puts "VERIFY: EOF waiting exit code"; exit 1 }
}
expect {
    -re {\$ $} { puts "VERIFY: post-mortem done" }
    timeout { puts "VERIFY: TIMEOUT after post-mortem"; exit 1 }
    eof { puts "VERIFY: EOF after post-mortem"; exit 1 }
}
puts "VERIFY: ALL OK"
