#!/usr/bin/expect -f
# Live acceptance for #281 (bootstat shell command).
# Usage: expect -f tools/verify-281.exp run-debug-mode
set timeout 600
eval spawn make $argv
expect {
    -re {\$ $} { puts "VERIFY: prompt reached" }
    timeout { puts "VERIFY: TIMEOUT waiting for prompt"; exit 1 }
    eof { puts "VERIFY: EOF before prompt"; exit 1 }
}
send "bootstat\r"
expect {
    -re {ARCH_INIT} { puts "VERIFY: stage lines present" }
    timeout { puts "VERIFY: TIMEOUT waiting bootstat output"; exit 1 }
    eof { puts "VERIFY: EOF waiting bootstat output"; exit 1 }
}
expect {
    -re {total:.*budget} { puts "VERIFY: total/budget line present" }
    timeout { puts "VERIFY: TIMEOUT waiting total line"; exit 1 }
    eof { puts "VERIFY: EOF waiting total line"; exit 1 }
}
expect {
    -re {\$ $} { puts "VERIFY: bootstat done" }
    timeout { puts "VERIFY: TIMEOUT after bootstat"; exit 1 }
    eof { puts "VERIFY: EOF after bootstat"; exit 1 }
}
send "bootstat extra-arg\r"
expect {
    -re {Usage: bootstat} { puts "VERIFY: usage on extra args" }
    timeout { puts "VERIFY: TIMEOUT waiting usage line"; exit 1 }
    eof { puts "VERIFY: EOF waiting usage line"; exit 1 }
}
puts "VERIFY: ALL OK"
