# NexIOS RTOS — autonomous test runner (expect driver)
# Usage: expect run-test.exp <timeout_sec> <verdict_log> <serial_log> <qemu_cmd...>
# Matches the kernel's TEST SUMMARY block, writes a machine-readable verdict
# to <verdict_log>, and exits 0 on PASS / 1 on FAIL|TIMEOUT|QEMU_EXIT.
#
# Expected-panic handling (issue #181):
#   The TEST SUMMARY block is authoritative — it decides the verdict whenever
#   present, even if a KERNEL PANIC: line appeared earlier in the same run
#   (passing tests may log benign FATAL lines). Panic text is therefore only
#   RECORDED, never terminal: a flag is set and matching continues. Only when
#   the run ends (eof) or the deadline passes (timeout) with NO summary does
#   the recorded flag decide: the exact `exhausted PCP retry budget`
#   signature (ASIL-D safety panic, kernel halts, no summary follows) yields
#   PASS, any other recorded panic yields FAIL.
#
# Robust by design:
#   - The verdict is written to a dedicated file (never lost to pipe buffering).
#   - The summary regex decides whenever matched; all paths (PASS/FAIL/TIMEOUT/
#     EOF) write the verdict file before exiting; `verdict` is pre-initialized
#     so no path can reference it unset.

set timeout [lindex $argv 0]
set verdict_log [lindex $argv 1]
set serial_log [lindex $argv 2]
set qemu_args [lrange $argv 3 end]
fconfigure stdout -buffering none
spawn {*}$qemu_args
# Verdict state (issue #181): pre-initialized so no path can reference
# `verdict` unset; panic sightings only set flags and continue — the
# TEST SUMMARY arm below stays reachable for the rest of the run.
set verdict "RESULT: UNKNOWN (expect internal error)"
set panic_seen 0
set expected_panic_seen 0
set orig_timeout $timeout
set deadline [expr {[clock seconds] + $timeout}]
# Tcl regex is POSIX-ish: no (?s), (?:), or non-greedy *?.  Match the summary
# block line-by-line with explicit [\r\n] breaks.  Group indices:
#   1=PLANNED 2=EXECUTED 3=TIME_ELAPSED 4=BOOT_TIME (ignored) 5=PASSED 6=FAILED
#
# Arm order is readability only, not correctness: panic arms never exit, so
# a panic line earlier in the buffer cannot shadow a SUMMARY later in it.
expect {
    # ── Normal TEST SUMMARY (authoritative whenever present) ─────────
    -re {[\r\n]+==============================[\r\n]+ TEST SUMMARY[\r\n]+==============================[\r\n]+  PLANNED:\s+(\d+)[\r\n]+  EXECUTED:\s+(\d+)[\r\n]+  TIME_ELAPSED_MS:\s+(\d+)([\r\n]+  BOOT_TIME_MS:\s+\d+)?[\r\n]+  PASSED:\s+(\d+)[\r\n]+  FAILED:\s+(\d+)[\r\n]+==============================} {
        if {$expect_out(1,string) == $expect_out(2,string) && $expect_out(6,string) == 0} {
            set verdict "RESULT: PASS ($expect_out(1,string) tests, test=$expect_out(3,string) ms, failed=$expect_out(6,string))"
            set rc 0
        } else {
            set verdict "RESULT: FAIL (planned=$expect_out(1,string) executed=$expect_out(2,string) failed=$expect_out(6,string))"
            set rc 1
        }
        puts $verdict; flush stdout
        set fh [open $verdict_log w]; puts $fh $verdict; close $fh
        exit $rc
    }
    # ── Expected panic signature seen — record, keep waiting for summary.
    #    Bare substring (not same-chunk anchored): robust to split writes.
    #    Decides nothing by itself; only the eof/timeout arms below read it.
    -re {exhausted PCP retry budget} {
        set expected_panic_seen 1
        set panic_seen 1
        set remaining [expr {$deadline - [clock seconds]}]
        if {$remaining <= 0} {
            set verdict "RESULT: PASS (expected panic: PCP retry budget exhausted)"
            puts $verdict; flush stdout
            set fh [open $verdict_log w]; puts $fh $verdict; close $fh
            exit 0
        }
        set timeout $remaining
        exp_continue
    }
    # ── Any other KERNEL PANIC: line — record, keep waiting for summary ─
    -re {KERNEL PANIC:} {
        set panic_seen 1
        set remaining [expr {$deadline - [clock seconds]}]
        if {$remaining <= 0} {
            set verdict "RESULT: FAIL (unexpected kernel panic)"
            puts $verdict; flush stdout
            set fh [open $verdict_log w]; puts $fh $verdict; close $fh
            exit 1
        }
        set timeout $remaining
        exp_continue
    }
    # ── Timeout (no summary and no QEMU exit within the deadline) ─────
    timeout {
        if {$expected_panic_seen} {
            set verdict "RESULT: PASS (expected panic: PCP retry budget exhausted)"
            puts $verdict; flush stdout
            set fh [open $verdict_log w]; puts $fh $verdict; close $fh
            exit 0
        } elseif {$panic_seen} {
            set verdict "RESULT: FAIL (unexpected kernel panic)"
            puts $verdict; flush stdout
            set fh [open $verdict_log w]; puts $fh $verdict; close $fh
            exit 1
        }
        set verdict "RESULT: TIMEOUT (no TEST SUMMARY within $orig_timeout s)"
        puts $verdict; flush stdout
        set fh [open $verdict_log w]; puts $fh $verdict; close $fh
        exit 1
    }
    # ── EOF (QEMU exited) — panic flags decide only without a summary ──
    eof {
        if {$expected_panic_seen} {
            set verdict "RESULT: PASS (expected panic: PCP retry budget exhausted)"
            puts $verdict; flush stdout
            set fh [open $verdict_log w]; puts $fh $verdict; close $fh
            exit 0
        } elseif {$panic_seen} {
            set verdict "RESULT: FAIL (unexpected kernel panic)"
            puts $verdict; flush stdout
            set fh [open $verdict_log w]; puts $fh $verdict; close $fh
            exit 1
        }
        set verdict "RESULT: QEMU_EXIT (no TEST SUMMARY -- kernel crashed/hung)"
        puts $verdict; flush stdout
        set fh [open $verdict_log w]; puts $fh $verdict; close $fh
        exit 1
    }
}
