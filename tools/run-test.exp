# NexIOS RTOS — autonomous test runner (expect driver)
# Usage: expect run-test.exp <timeout_sec> <verdict_log> <serial_log> <qemu_cmd...>
# Matches the kernel's TEST SUMMARY block, writes a machine-readable verdict
# to <verdict_log>, and exits 0 on PASS / 1 on FAIL|TIMEOUT|QEMU_EXIT.
#
# Expected-panic handling:
#   Known panic signatures are listed in EXPECTED_PANIC_PATTERNS.  When the
#   serial output matches one of these, the harness records a PASS with an
#   annotation instead of waiting for watchdog timeout.  This allows the test
#   infrastructure to accept ASIL-D mandated safety panics that occur under
#   legitimate contention scenarios.
#
# Robust by design:
#   - The verdict is written to a dedicated file (never lost to pipe buffering).
#   - A single regex matches the summary; all paths (PASS/FAIL/TIMEOUT/EOF)
#     write the verdict file before exiting.

set timeout [lindex $argv 0]
set verdict_log [lindex $argv 1]
set serial_log [lindex $argv 2]
set qemu_args [lrange $argv 3 end]
fconfigure stdout -buffering none
spawn {*}$qemu_args
# Tcl regex is POSIX-ish: no (?s), (?:), or non-greedy *?.  Match the summary
# block line-by-line with explicit [\r\n] breaks.  Group indices:
#   1=PLANNED 2=EXECUTED 3=TIME_ELAPSED 4=BOOT_TIME (ignored) 5=PASSED 6=FAILED
#
# Panic handling — patterns are tried in order; first match wins:
#   1. Expected panics (specific messages caught first → PASS)
#   2. Unexpected panics (any KERNEL PANIC not matched above → FAIL)
#   3. Normal TEST SUMMARY (all tests completed)
#   4. timeout / eof (no summary / QEMU exited)
expect {
    # ── Expected: PCP retry budget exhaustion (ASIL-D safety) ─────
    # Full message arrives as one serial chunk after the prefix.
    -re {KERNEL PANIC:.*exhausted PCP retry budget} {
        set verdict "RESULT: PASS (expected panic: PCP retry budget exhausted)"
        puts $verdict; flush stdout
        set fh [open $verdict_log w]; puts $fh $verdict; close $fh
        close $spawn_id
        exit 0
    }
    # ── KERNEL PANIC: prefix seen but full message not yet arrived ─
    # Block for up to 2 s waiting for the rest of the message; then
    # check for expected pattern.  If not found, classify as unexpected.
    -re {KERNEL PANIC:} {
        set old_timeout $timeout
        set timeout 2
        expect {
            -re {exhausted PCP retry budget} {
                set verdict "RESULT: PASS (expected panic: PCP retry budget exhausted)"
            }
            timeout {
                set verdict "RESULT: FAIL (unexpected kernel panic)"
            }
        }
        set timeout $old_timeout
        puts $verdict; flush stdout
        set fh [open $verdict_log w]; puts $fh $verdict; close $fh
        catch {close $spawn_id}
        exit [expr {[string match "*FAIL*" $verdict] ? 1 : 0}]
    }
    # ── Normal TEST SUMMARY ────────────────────────────────────────
    -re {[\r\n]+==============================[\r\n]+ TEST SUMMARY[\r\n]+==============================[\r\n]+  PLANNED:\s+(\d+)[\r\n]+  EXECUTED:\s+(\d+)[\r\n]+  TIME_ELAPSED_MS:\s+(\d+)([\r\n]+  BOOT_TIME_MS:\s+\d+)?[\r\n]+  PASSED:\s+(\d+)[\r\n]+  FAILED:\s+(\d+)[\r\n]+==============================} {
        if {$expect_out(1,string) == $expect_out(2,string) && $expect_out(6,string) == 0} {
            set verdict "RESULT: PASS ($expect_out(1,string) tests, test=$expect_out(3,string) ms, failed=$expect_out(6,string))"
            set rc 0
        } else {
            set verdict "RESULT: FAIL (planned=$expect_out(1,string) executed=$expect_out(2,string) failed=$expect_out(6,string))"
            set rc 1
        }
        puts $verdict; flush stdout
        set fh [open $verdict_log w]; puts $fh $verdict; close $fh
        exit $rc
    }
    # ── Timeout ────────────────────────────────────────────────────
    timeout {
        set verdict "RESULT: TIMEOUT (no TEST SUMMARY within $timeout s)"
        puts $verdict; flush stdout
        set fh [open $verdict_log w]; puts $fh $verdict; close $fh
        exit 1
    }
    # ── EOF (QEMU exited without summary) ──────────────────────────
    eof {
        set verdict "RESULT: QEMU_EXIT (no TEST SUMMARY -- kernel crashed/hung)"
        puts $verdict; flush stdout
        set fh [open $verdict_log w]; puts $fh $verdict; close $fh
        exit 1
    }
}
        set verdict "RESULT: TIMEOUT (no TEST SUMMARY within $timeout s)"
        puts $verdict
        flush stdout
        set fh [open $verdict_log w]
        puts $fh $verdict
        close $fh
        exit 1
    }
    eof {
        # QEMU exited on its own (e.g. via qemu_debug_exit) but no TEST SUMMARY
        set verdict "RESULT: QEMU_EXIT (no TEST SUMMARY -- kernel hanged or unexpected exit)"
        puts $verdict
        flush stdout
        set fh [open $verdict_log w]
        puts $fh $verdict
        close $fh
        exit 1
    }
}
