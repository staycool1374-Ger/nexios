{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": "allow",
    "external_directory": {
      "*": "deny",
      "/tmp/nexios-*": "allow",
      "/tmp/nexios-*/**": "allow",
      "/tmp/jarvis-*": "allow",
      "/tmp/jarvis-*/**": "allow",
      "/tmp/jarvis_*": "allow",
      "/tmp/matrix-*": "allow",
      "/tmp/qemu-serial.*": "allow",
      "/tmp/agentup-*": "allow"
    },
    "edit": {
      "*": "deny",
      "/tmp/nexios-*/*": "allow",
      "/tmp/nexios-*/**/*": "allow",
      "src/kernel/test/*": "allow",
      "src/kernel/test/**/*": "allow",
      "src/test/*": "allow",
      "src/test/**/*": "allow"
    }
  }
}
