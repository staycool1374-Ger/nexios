{
  "$schema": "https://opencode.ai/config.json",
  "bash": "allow",
  "external_default": "deny",
  "namespaces": [
    {
      "root": "/tmp/nexios-*",
      "decision": "allow",
      "external_variants": ["", "/**"],
      "edit_variants": ["/*", "/**/*"]
    },
    {
      "root": "/tmp/jarvis-*",
      "decision": "allow",
      "external_variants": ["", "/**"]
    },
    {
      "root": "/tmp/jarvis_*",
      "decision": "allow",
      "external_variants": [""]
    },
    {
      "root": "/tmp/matrix-*",
      "decision": "allow",
      "external_variants": [""]
    },
    {
      "root": "/tmp/qemu-serial.*",
      "decision": "allow",
      "external_variants": [""]
    },
    {
      "root": "/tmp/agentup-*",
      "decision": "allow",
      "external_variants": ["", "/**"]
    },
    {
      "root": "/tmp/lldb-*",
      "decision": "allow",
      "external_variants": [""]
    }
  ],
  "edit_deny": [
    "tools/agents/fence/*",
    "tools/agents/fence/**/*",
    ".opencode/agents/*",
    ".opencode/agents/**/*"
  ]
}
