{
  "role": "dev",
  "edit_default": "allow",
  "edit_allow": [],
  "edit_deny": [
    "src/kernel/test/*",
    "src/kernel/test/**/*",
    "src/test/*",
    "src/test/**/*"
  ],
  "external_allow": [],
  "launch": {
    "cwd": "dev",
    "prompt": "dev.txt"
  },
  "agent": {
    "name": "nexios-dev",
    "twin": "nexios-dev.md",
    "description": "Nexios kernel developer (fenced to main worktree, test trees read-only)",
    "mode": "subagent",
    "bash": {
      "*": "ask",
      "rg *": "allow",
      "echo *": "allow",
      "head *": "allow",
    "git ls-files *": "allow",
      "git -C */jarvis *": "allow",
      "git -C */jarvis_test *": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git status*": "allow",
      "git branch*": "allow",
      "git add*": "allow",
      "git commit*": "allow",
      "git checkout*": "allow",
      "git stash*": "allow",
      "git rev-parse*": "allow",
      "git merge-base*": "allow",
      "git check-ignore*": "allow",
      "git apply --check*": "allow",
      "diff *": "allow",
      "grep *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "ls *": "allow",
      "cat *": "allow",
      "find *": "allow",
      "sed *": "allow",
      "date *": "allow",
      "python3 *": "allow",
      "meson *": "allow",
      "ninja *": "allow",
      "expect *": "allow",
      "qemu-system-*": "allow",
      "mkdir *": "allow",
      "cp *": "allow",
      "bash *": "allow",
      "command *": "allow",
      "test *": "allow",
      "printf *": "allow",
      "tmux ls*": "allow",
      "gh issue view *": "allow",
      "gh issue list *": "allow",
      "scripts/agent_up.sh*": "allow"
    }
  }
}
