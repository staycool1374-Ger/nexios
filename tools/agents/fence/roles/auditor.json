{
  "role": "auditor",
  "edit_default": "deny",
  "edit_allow": [
    "audits/rejected_patch.diff",
    "audits/report-*.md"
  ],
  "edit_deny": [],
  "external_allow": [],
  "launch": {
    "cwd": "audit",
    "prompt": "auditor.txt"
  },
  "agent": {
    "name": "nexios-audit",
    "twin": "nexios-audit.md",
    "description": "NexIOS SIL 3 safety auditor (read-only, never edits)",
    "mode": "subagent",
    "model": "opencode-go/muse-spark-1.3-contributor",
    "temperature": 0.0,
    "bash": {
      "*": "ask",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git status*": "allow",
      "git apply --check*": "allow",
      "diff *": "allow",
      "grep *": "allow",
      "tail *": "allow",
      "wc *": "allow"
    },
    "alias": [
      "sil3_auditor.md"
    ]
  }
}
