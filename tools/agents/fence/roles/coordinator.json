{
  "role": "coordinator",
  "edit_default": "deny",
  "edit_allow": [
    "{repo}/prompts/LEARNINGS.md"
  ],
  "edit_deny": [],
  "external_allow": [
    "{repo}/prompts/**",
    "{repo}/audits/**"
  ],
  "launch": {"cwd": "coord"},
  "config_extra": {
    "model": "opencode-go/muse-spark-1.3-contributor",
    "mcp": {
      "harness": {
        "type": "local",
        "command": ["harness", "mcp"],
        "enabled": true
      },
      "github": {
        "type": "remote",
        "url": "https://api.githubcopilot.com/mcp/",
        "enabled": true,
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {env:GITHUB_PERSONAL_ACCESS_TOKEN}"
        }
      }
    }
  }
}
