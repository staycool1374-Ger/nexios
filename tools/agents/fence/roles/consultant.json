{
  "role": "consultant",
  "edit_default": "allow",
  "edit_allow": [
    "{repo}/**"
  ],
  "edit_deny": [
    "{repo}/src",
    "{repo}/src/**"
  ],
  "external_allow": [
    "{repo}/**"
  ],
  "launch": {
    "cwd": "consultant"
  },
  "agent": {
    "name": "nexios-consultant",
    "twin": "nexios-consultant.md",
    "description": "Nexios workflow consultant (writes repo except src/ + full /tmp; GitHub issues/PRs/releases; never orchestrates workers)",
    "mode": "subagent",
    "bash": {
      "*": "ask",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "ls *": "allow",
      "grep *": "allow",
      "wc *": "allow",
      "find *": "allow",
      "sed *": "allow",
      "diff *": "allow",
      "date *": "allow",
      "printf *": "allow",
      "echo *": "allow",
      "test *": "allow",
      "command *": "allow",
      "rg *": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git diff*": "allow",
      "git status*": "allow",
      "git branch*": "allow",
      "git ls-files*": "allow",
      "git rev-parse*": "allow",
      "git merge-base*": "allow",
      "git check-ignore*": "allow",
      "git add *": "allow",
      "git commit*": "allow",
      "git push*": "allow",
      "git checkout*": "allow",
      "git merge*": "allow",
      "git fetch*": "allow",
      "git tag*": "allow",
      "git -C *": "allow",
      "tmux ls*": "allow",
      "tmux has-session*": "allow",
      "tmux list-panes*": "allow",
      "tmux capture-pane*": "allow",
      "python3 *": "allow",
      "gh issue view *": "allow",
      "gh issue list*": "allow",
      "gh issue create*": "allow",
      "gh issue comment*": "allow",
      "gh issue edit*": "allow",
      "gh issue close*": "allow",
      "gh issue reopen*": "allow",
      "gh pr view*": "allow",
      "gh pr list*": "allow",
      "gh pr create*": "allow",
      "gh pr comment*": "allow",
      "gh pr review*": "allow",
      "gh pr edit*": "allow",
      "gh pr close*": "allow",
      "gh pr reopen*": "allow",
      "gh pr merge*": "allow",
      "gh release view*": "allow",
      "gh release list*": "allow",
      "gh release create*": "allow",
      "gh release edit*": "allow",
      "gh release upload*": "allow",
      "gh api repos/*": "allow",
      "scripts/agent_up.sh status*": "allow",
      "scripts/agent_up.sh fence show*": "allow",
      "scripts/agent_up.sh watch * status": "allow"
    }
  },
  "config_extra": {
    "model": "opencode-go/muse-spark-1.3-contributor",
    "mcp": {
      "harness": {
        "type": "local",
        "command": [
          "harness",
          "mcp"
        ],
        "enabled": true
      },
      "github": {
        "type": "remote",
        "url": "https://api.githubcopilot.com/mcp/",
        "enabled": true,
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {env:GITHUB_PERSONAL_ACCESS_TOKEN}"
        }
      }
    }
  }
}
