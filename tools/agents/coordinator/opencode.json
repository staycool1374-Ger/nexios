{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": "allow",
    "external_directory": {
      "*": "deny",
      "{repo}/prompts/**": "allow",
      "{repo}/audits/**": "allow",
      "/tmp/nexios-*": "allow",
      "/private/tmp/nexios-*": "allow",
      "/tmp/nexios-*/**": "allow",
      "/private/tmp/nexios-*/**": "allow",
      "/tmp/jarvis-*": "allow",
      "/private/tmp/jarvis-*": "allow",
      "/tmp/jarvis-*/**": "allow",
      "/private/tmp/jarvis-*/**": "allow",
      "/tmp/jarvis_*": "allow",
      "/private/tmp/jarvis_*": "allow",
      "/tmp/matrix-*": "allow",
      "/private/tmp/matrix-*": "allow",
      "/tmp/qemu-serial.*": "allow",
      "/private/tmp/qemu-serial.*": "allow",
      "/tmp/agentup-*": "allow",
      "/private/tmp/agentup-*": "allow",
      "/tmp/agentup-*/**": "allow",
      "/private/tmp/agentup-*/**": "allow",
      "/tmp/lldb-*": "allow",
      "/private/tmp/lldb-*": "allow"
    },
    "edit": {
      "*": "deny",
      "/tmp/nexios-*/*": "allow",
      "/private/tmp/nexios-*/*": "allow",
      "/tmp/nexios-*/**/*": "allow",
      "/private/tmp/nexios-*/**/*": "allow",
      "{repo}/prompts/LEARNINGS.md": "allow"
    }
  },
  "mcp": {
    "harness": {
      "type": "local",
      "command": [
        "harness",
        "mcp"
      ],
      "enabled": true
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    }
  }
}
